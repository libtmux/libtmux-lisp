(in-package #:libtmux.internal)

(defstruct server-witness pid start socket endpoint version device inode process-start fd)

(defun close-witness (witness)
  (when (and witness (server-witness-fd witness))
    (unwind-protect (close-descriptor (server-witness-fd witness))
      (setf (server-witness-fd witness) nil))))

(defun release-client-witness (client)
  (let ((witness (slot-value client 'libtmux::witness)))
    (unwind-protect (close-witness witness)
      (setf (slot-value client 'libtmux::witness) nil))))

(defun invalidate-client-generation (client)
  (when (slot-value client 'libtmux::witness)
    (incf (slot-value client 'libtmux::generation))
    (release-client-witness client)))

(defun linux-process-start (pid)
  (let ((buffer (make-array 8192 :element-type '(unsigned-byte 8))))
    (with-open-file (stream (format nil "/proc/~D/stat" pid) :element-type '(unsigned-byte 8))
      (let* ((count (read-sequence buffer stream))
             (end (position 41 buffer :end count :from-end t)))
        (unless (and end (< count (length buffer)))
          (inconsistent-capture "Cannot decode the server process-start witness"))
        (let* ((fields (remove "" (uiop:split-string (strict-text (subseq buffer (1+ end) count))
                                                    :separator '(#\Space #\Newline #\Tab))
                               :test #'equal))
               (token (nth 19 fields)))
          (unless (and token (plusp (length token))
                       (every (lambda (char) (char<= #\0 char #\9)) token))
            (inconsistent-capture "Missing server process-start witness"))
          (parse-integer token))))))

(defun socket-identity (path)
  (let ((stat (sb-posix:stat path)))
    (unless (sb-posix:s-issock (sb-posix:stat-mode stat))
      (inconsistent-capture "The reported tmux endpoint is not a socket"))
    (list (sb-posix:stat-dev stat) (sb-posix:stat-ino stat))))

(defun witness-from-row (client row)
  (let* ((pid (row-value row :server/pid))
         (socket (row-value row :server/socket-path))
         (version (supported-version (row-value row :server/version)))
         (fd nil) (retained nil))
    (unwind-protect
         (handler-case
             (let ((socket-before (socket-identity socket))
                   (endpoint (canonical-native-path socket))
                   (selected (slot-value client 'libtmux::socket-path))
                   (process-before (linux-process-start pid)))
               (setf fd (pidfd-open pid 0))
               (when (minusp fd)
                 (setf fd nil)
                 (inconsistent-capture "Cannot retain the tmux server process witness"))
               (unless (and (equal socket-before (socket-identity socket))
                            (equal socket-before (socket-identity endpoint))
                            (or (not selected) (equal socket-before (socket-identity selected)))
                            (= process-before (linux-process-start pid))
                            (null (poll-owned (list (list :server fd :input)) 0)))
                 (inconsistent-capture "Server identity changed while acquiring its witness"))
               (prog1 (make-server-witness :pid pid :start (row-value row :server/start-time)
                                           :socket (copy-seq socket) :endpoint endpoint :version version
                                           :device (first socket-before) :inode (second socket-before)
                                           :process-start process-before :fd fd)
                 (setf retained t)))
           (libtmux:incomplete-snapshot (condition) (error condition))
           (error (condition)
             (error 'libtmux:incomplete-snapshot :cause condition
                    :message "Cannot establish live server continuity")))
      (unless retained (when fd (close-descriptor fd))))))

(defun witness-values (witness)
  (list (server-witness-pid witness) (server-witness-start witness)
        (server-witness-socket witness) (server-witness-endpoint witness) (server-witness-version witness)
        (server-witness-device witness) (server-witness-inode witness)
        (server-witness-process-start witness)))

(defun same-witness-p (left right)
  (and left right (server-witness-fd left) (server-witness-fd right)
       (equal (witness-values left) (witness-values right))
       (null (poll-owned (list (list :old (server-witness-fd left) :input)
                               (list :new (server-witness-fd right) :input)) 0))))

(defun accept-server-witness (client witness)
  (let ((old (slot-value client 'libtmux::witness)) (retained nil))
    (unwind-protect
         (if (same-witness-p old witness)
             old
             (progn
               (release-client-witness client)
               (incf (slot-value client 'libtmux::generation))
               (setf (slot-value client 'libtmux::witness) witness retained t)
               witness))
      (unless retained (close-witness witness)))))

(defun witness-provenance (witness)
  (list :server/pid (server-witness-pid witness)
        :server/start-time (server-witness-start witness)
        :server/socket-path (copy-seq (server-witness-socket witness))
        :server/version (copy-seq (server-witness-version witness))
        :server/socket-device (server-witness-device witness)
        :server/socket-inode (server-witness-inode witness)
        :server/process-start (server-witness-process-start witness)))
