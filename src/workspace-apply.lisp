(in-package #:libtmux.workspace)

(defstruct owned-application
  client declaration options deadline reconcile state initial-plan plan writer snapshot
  session-id (windows nil) (geometry-effects nil) candidate publication observed
  (phase :acquire) step (status :running))

(defclass owned-result ()
  ((data :initarg :data) (snapshot :initarg :snapshot) (outcomes :initarg :outcomes))
  (:documentation "Private completed application evidence, with local defensive inspection."))

(define-condition owned-apply-error (workspace-error)
  ((data :initarg :data) (snapshot :initarg :snapshot) (outcomes :initarg :outcomes))
  (:documentation "Private application stopped with retained mappings, capture and outcomes."))

(defun owned-result-data (result) (deep-copy (slot-value result 'data)))
(defun owned-result-snapshot (result) (slot-value result 'snapshot))
(defun owned-result-outcomes (result) (copy-seq (slot-value result 'outcomes)))
(defun owned-apply-error-data (condition) (deep-copy (slot-value condition 'data)))
(defun owned-apply-error-snapshot (condition) (slot-value condition 'snapshot))
(defun owned-apply-error-outcomes (condition) (copy-seq (slot-value condition 'outcomes)))

(defun owned-observation-error-data (condition)
  (loop for cause = condition then (libtmux:error-cause cause)
        while (typep cause 'libtmux:libtmux-error)
        when (typep cause 'owned-state-error) return (slot-value cause 'data)))

(defun owned-application-data (application &optional cause)
  (let* ((state (owned-application-state application))
         (writer (owned-application-writer application))
         (candidate (owned-application-candidate application))
         (publication (owned-application-publication application)))
    (deep-copy
     (list :status (owned-application-status application) :phase (owned-application-phase application)
           :step (when (owned-application-step application) (step-data (owned-application-step application)))
           :initial-plan (when (owned-application-initial-plan application)
                           (owned-plan-data (owned-application-initial-plan application)))
           :plan (when (owned-application-plan application) (owned-plan-data (owned-application-plan application)))
           :mappings (list :session-id (owned-application-session-id application)
                           :windows (coerce (owned-application-windows application) 'vector))
           :selected-state (when state (slot-value state 'data))
           :candidate (when candidate (slot-value candidate 'data))
           :observed-state (or (owned-observation-error-data cause) (owned-application-observed application))
           :record (if (and publication (eq :succeeded (libtmux:outcome-status publication)))
                       (when candidate (slot-value candidate 'data))
                       (when state (getf (slot-value state 'data) :committed)))
           :writer (when writer (owned-writer-data writer))
           :publication-status (when publication (libtmux:outcome-status publication))
           :publication-reason (when publication (libtmux:outcome-reason publication))))))

(defun owned-application-outcomes (application &optional cause)
  (let ((outcomes nil))
    (labels ((retain (sequence)
               (map nil (lambda (outcome) (unless (member outcome outcomes) (push outcome outcomes))) sequence))
             (failure (condition)
               (typecase condition
                 (owned-state-error (retain (owned-state-error-outcomes condition)))
                 (libtmux:libtmux-error
                  (let ((outcome (libtmux:error-outcome condition))) (when outcome (retain (vector outcome))))))
               (when (and (typep condition 'libtmux:libtmux-error) (libtmux:error-cause condition))
                 (failure (libtmux:error-cause condition)))))
      (when (owned-application-state application)
        (retain (owned-state-outcomes (owned-application-state application))))
      (when (owned-application-writer application)
        (retain (owned-writer-outcomes (owned-application-writer application))))
      (when cause (failure cause)))
    (coerce (nreverse outcomes) 'simple-vector)))

(defun owned-session-precondition (session)
  (list (concatenate 'string (libtmux:id session) ":")
        (libtmux.internal::format-conjunction
         (list (libtmux.internal::format-equal "session_id" (libtmux:id session))
               (libtmux.internal::format-equal "session_grouped" 0)))))

(defun owned-window-precondition (link version &optional mapped-panes)
  "Generate fixed link/share predicates and, when requested, complete regular-pane guards."
  (destructuring-bind (session index window-id) (libtmux:id link)
    (let ((expressions (list (libtmux.internal::format-equal "session_id" session)
                             (libtmux.internal::format-equal "session_grouped" 0)
                             (libtmux.internal::format-equal "window_index" index)
                             (libtmux.internal::format-equal "window_id" window-id)
                             (libtmux.internal::format-equal "window_linked" 0))))
      (when mapped-panes
        (let* ((profile (owned-geometry-profile version))
               (panes (coerce (libtmux:panes (libtmux:window link)) 'list))
               (actual (mapcar #'libtmux:id panes))
               (ordered (if (member version '("3.3a" "3.4" "3.5" "3.5a") :test #'string=)
                            panes
                            (sort (copy-list panes) #'< :key (lambda (pane) (parse-integer (libtmux:id pane) :start 1)))))
               (wanted (libtmux.internal::finite-vector mapped-panes "Mapped geometry panes")))
          (unless (and (plusp (length actual)) (= (length actual) (length wanted))
                       (= (length wanted) (length (remove-duplicates wanted :test #'equal)))
                       (every (lambda (id) (find id wanted :test #'equal)) actual))
            (fail-workspace "Geometry changes require the complete mapped pane set" :type 'workspace-conflict))
          (setf expressions
                (append expressions
                        (list (libtmux.internal::format-equal "window_zoomed_flag" 0)
                              (libtmux.internal::format-equal "window_panes" (length actual))
                              (format nil "#{==:#{P:#{pane_id}.#{pane_index}.~A.~A.},~{~A~}}"
                                      (if (eq profile :legacy) "0" "#{pane_floating_flag}")
                                      (if (eq profile :modal) "#{pane_modal_flag}" "0")
                                      (mapcar (lambda (pane) (format nil "~A.~D.0.0." (libtmux:id pane) (libtmux:index pane)))
                                              ordered)))))))
      (list (libtmux.internal::link-target link) (libtmux.internal::format-conjunction expressions)))))

(defun owned-application-session (application &optional (snapshot (owned-application-snapshot application)))
  (or (find (owned-application-session-id application) (libtmux:sessions snapshot)
            :key #'libtmux:id :test #'equal)
      (fail-workspace "Mapped session is missing from the replacement capture" :type 'workspace-conflict)))

(defun owned-application-window-map (application logical-id)
  (or (owned-by-id logical-id (owned-application-windows application) :logical-id)
      (fail-workspace "Planned logical window has no known physical identity" :type 'workspace-conflict)))

(defun owned-application-link (application mapped &optional (snapshot (owned-application-snapshot application)))
  (let ((identity (list (owned-application-session-id application) (getf mapped :index) (getf mapped :physical-id))))
    (or (find identity (libtmux:window-links (owned-application-session application snapshot))
              :key #'libtmux:id :test #'equal)
        (fail-workspace "Mapped window link is missing or changed" :type 'workspace-conflict))))

(defun owned-application-pane (application mapped logical-id)
  (let ((pane (owned-by-id logical-id (getf mapped :panes) :logical-id)))
    (or (and pane (find (getf pane :physical-id)
                        (libtmux:panes (libtmux:window (owned-application-link application mapped)))
                        :key #'libtmux:id :test #'equal))
        (fail-workspace "Mapped anchor pane is missing or reparented" :type 'workspace-conflict))))

(defun validate-application-mappings (application snapshot)
  (when (owned-application-session-id application)
    (owned-application-session application snapshot)
    (dolist (mapped (owned-application-windows application))
      (let* ((window (libtmux:window (owned-application-link application mapped snapshot)))
             (actual (map 'list #'libtmux:id (libtmux:panes window))))
        (dolist (pane (getf mapped :panes))
          (unless (member (getf pane :physical-id) actual :test #'equal)
            (fail-workspace "An owned pane disappeared or changed parent" :type 'workspace-conflict)))))))

(defun owned-application-facts (application reader)
  (let* ((snapshot (owned-read-graph reader))
         (groups (owned-read-groups reader snapshot))
         (geometry (owned-read-geometry reader snapshot)))
    (validate-application-mappings application snapshot)
    (when (owned-application-session-id application)
      (let ((group (find (owned-application-session-id application) groups :key #'car :test #'equal)))
        (unless (and group (null (cdr group)))
          (fail-workspace "Owned application requires an ungrouped session" :type 'workspace-conflict))))
    (values snapshot groups geometry)))

(defun owned-record-reference (header)
  (list :revision (getf header :revision) :bytes (getf header :bytes) :chunks (getf header :chunks)))

(defun owned-record-header (record)
  (normalize-owned-descriptor (parse-owned-tree (nth-value 0 (encode-owned-record record))) (make-owned-context :json)))

(defun owned-initial-header (application)
  (let* ((state (slot-value (owned-application-state application) 'data))
         (head (getf (getf state :committed) :revision)))
    (find-if (lambda (header) (and (eq :committed (getf header :kind)) (equal head (getf header :revision))))
             (getf state :headers))))

(defun call-with-owned-application-reader (application procedure)
  "Retain complete bracketed read evidence; partial failures remain in their cause."
  (let ((observed nil))
    (multiple-value-prog1
        (owned-writer-read (owned-application-writer application)
                           (lambda (reader) (setf observed reader) (funcall procedure reader)))
      (setf (owned-application-observed application)
            (owned-reader-data observed (owned-application-client application)
                               (libtmux.internal::capture-budget-start
                                (libtmux.internal::configuration-reader-budget (owned-reader-core observed))))))))

(defun recheck-owned-application (application)
  (let* ((writer (owned-application-writer application))
         (old (slot-value (owned-application-state application) 'data)))
    (call-with-owned-application-reader
     application
     (lambda (reader)
       (owned-read-inventory reader)
       (loop for header across (getf old :headers)
             for kind = (getf header :kind) for revision = (getf header :revision)
             for key = (if (eq kind :pending) :pending
                           (if (equal revision (getf (getf old :committed) :revision)) :committed :previous))
             for observed = (owned-read-bundle reader kind revision (owned-record-reference header))
             do (unless (string= (slot-value observed 'json)
                                  (owned-record-json (make-owned-record kind (getf old key))))
                  (fail-workspace "Immutable workspace baseline changed after claim" :type 'workspace-conflict))
                (ecase key
                  (:committed (setf (owned-reader-committed reader) observed))
                  (:previous (setf (owned-reader-previous reader) observed))
                  (:pending (setf (owned-reader-pending reader) observed))))
       (check-owned-inventory reader (coerce (getf old :headers) 'list))
       (multiple-value-bind (snapshot groups geometry) (owned-application-facts application reader)
         (let ((data (deep-copy old)))
           ;; The known BUSY claim permits local replanning, never a READY acquisition result.
           (setf (getf data :control) (slot-value writer 'control)
                 (getf data :groups) groups (getf data :geometry) geometry)
           (setf (owned-application-plan application)
                 (plan-owned-workspace (owned-application-declaration application)
                                      (make-instance 'owned-state :data data :snapshot snapshot :outcomes #())
                                      :reconcile (owned-application-reconcile application))
                 (owned-application-snapshot application) snapshot
                 (owned-reader-status reader) :claimed)))))))

(defun install-application-session-guard (application)
  (setf (slot-value (owned-application-writer application) 'application-preconditions)
        (libtmux.internal::owned-dispatch-preconditions
         (list (owned-session-precondition (owned-application-session application))))))

(defun owned-created-window-map (application window data)
  (let* ((mapped (list :logical-id (getf data :window-id) :physical-id (libtmux:id window)
                       :index nil :layout nil :panes nil))
         (links (libtmux:window-links window)) (panes (libtmux:panes window)))
    (when (find (libtmux:id window) (owned-application-windows application)
                :key (lambda (item) (getf item :physical-id)) :test #'equal)
      (fail-workspace "Creation reused an already mapped physical window" :type 'workspace-conflict))
    (setf (owned-application-windows application) (append (owned-application-windows application) (list mapped)))
    (unless (and (= 1 (length links)) (= 1 (length panes))
                 (equal (owned-application-session-id application) (libtmux:id (libtmux:session (aref links 0)))))
      (fail-workspace "New window did not return one exclusive session link and seed pane" :type 'workspace-conflict))
    (setf (getf mapped :index) (libtmux:index (aref links 0))
          (getf mapped :layout) (libtmux:field-value window :window/layout)
          (getf mapped :panes) (list (list :logical-id (getf data :pane-id) :physical-id (libtmux:id (aref panes 0)))))
    (pushnew (libtmux:id window) (owned-application-geometry-effects application) :test #'equal)
    mapped))

(defun owned-step-call (application preconditions function type)
  (perform-owned-domain-command (owned-application-writer application) preconditions function :required-type type))

(defun execute-owned-step (application step)
  "Resolve one logical step against retained physical IDs and reuse its native core operation."
  (let* ((data (slot-value step 'data)) (action (step-action step))
         (client (owned-application-client application))
         (writer (owned-application-writer application))
         (version (libtmux.internal::server-witness-version (slot-value writer 'witness)))
         (mapped (unless (member action '(:create-session :create-window))
                   (when (getf data :window-id) (owned-application-window-map application (getf data :window-id)))))
         (link (when mapped (owned-application-link application mapped)))
         (geometry-p (member action '(:split-pane :select-layout)))
         (guards (when link (list (owned-window-precondition
                                  link version (when geometry-p (map 'vector (lambda (pane) (getf pane :physical-id))
                                                                     (getf mapped :panes)))))))
         (value nil))
    (when (and (eq action :move-window) (= (libtmux:index link) (getf data :index)))
      (owned-writer-check writer)
      (return-from execute-owned-step nil))
    (flet ((run (function type) (setf value (nth-value 1 (owned-step-call application guards function type)))))
      (ecase action
        (:create-session
         (run (lambda (options)
                (apply #'libtmux:new-session client :name (getf data :session-name) :window-name (getf data :name)
                       (append (step-creation-options data) options))) 'libtmux:session)
         (setf (owned-application-session-id application) (libtmux:id value))
         (let ((links (libtmux:window-links value)))
           (unless (= 1 (length links))
             (fail-workspace "New session did not return one initial window link" :type 'workspace-conflict))
           (owned-created-window-map application (libtmux:window (aref links 0)) data)))
        (:create-window
         (let ((session (owned-application-session application)))
           (run (lambda (options)
                  (apply #'libtmux:new-window client session :name (getf data :name)
                         (append (when (nth-value 1 (plist-value data :index)) (list :index (getf data :index)))
                                 (step-creation-options data) options))) 'libtmux:window))
         (owned-created-window-map application value data))
        (:move-window
         (run (lambda (options) (apply #'libtmux:move-window client link (owned-application-session application)
                                      (getf data :index) options)) 'libtmux:window-link)
         (unless (equal (getf mapped :physical-id) (libtmux:id (libtmux:window value)))
           (fail-workspace "Window move returned another physical window" :type 'workspace-conflict))
         (setf (getf mapped :index) (libtmux:index value)))
        (:rename-session
         (run (lambda (options) (apply #'libtmux:rename-session client (owned-application-session application)
                                      (getf data :name) options)) 'libtmux:session))
        (:rename-window
         (run (lambda (options) (apply #'libtmux:rename-window client (libtmux:window link) (getf data :name) options))
              'libtmux:window))
        (:split-pane
         (let* ((target (owned-application-pane application mapped (getf data :anchor-id)))
                (direction (if (>= (libtmux:width target) (libtmux:height target)) :horizontal :vertical)))
           (run (lambda (options)
                  (apply #'libtmux:split-pane client target :direction direction :before (getf data :before)
                         (append (step-creation-options data) options))) 'libtmux:pane))
         (when (some (lambda (window)
                       (find (libtmux:id value) (getf window :panes)
                             :key (lambda (pane) (getf pane :physical-id)) :test #'equal))
                     (owned-application-windows application))
           (fail-workspace "Split returned an already mapped pane" :type 'workspace-conflict))
         (setf (getf mapped :panes) (append (getf mapped :panes)
                                          (list (list :logical-id (getf data :pane-id) :physical-id (libtmux:id value))))))
        (:select-layout
         (run (lambda (options) (apply #'libtmux:select-layout client (libtmux:window link) (getf data :layout) options))
              'libtmux:window))))
    (let ((snapshot (slot-value value 'libtmux::snapshot)))
      (validate-application-mappings application snapshot)
      (when geometry-p
        (let ((window (libtmux:window (owned-application-link application mapped snapshot))))
          (unless (= (length (getf mapped :panes)) (length (libtmux:panes window)))
            (fail-workspace "Geometry replacement contains unmapped panes" :type 'workspace-conflict))
          (setf (getf mapped :layout) (libtmux:field-value window :window/layout))
          (pushnew (libtmux:id window) (owned-application-geometry-effects application) :test #'equal)))
      (setf (owned-application-snapshot application) snapshot)
      (when (eq action :create-session) (install-application-session-guard application)))))

(defun verify-unrelated-application-state (application snapshot)
  (let* ((before (owned-state-snapshot (owned-application-state application)))
         (windows (libtmux:windows snapshot)) (links (libtmux:window-links snapshot)))
    (loop for session across (libtmux:sessions before)
          unless (find (libtmux:id session) (libtmux:sessions snapshot) :key #'libtmux:id :test #'equal)
            do (fail-workspace "An existing session disappeared during application" :type 'workspace-conflict))
    (loop for link across (libtmux:window-links before)
          unless (find (libtmux:id link) links :key #'libtmux:id :test #'equal)
            do (fail-workspace "An existing contextual link changed during application" :type 'workspace-conflict))
    (loop for window across (libtmux:windows before)
          for id = (libtmux:id window) for current = (find id windows :key #'libtmux:id :test #'equal)
          for old-panes = (map 'list #'libtmux:id (libtmux:panes window))
          do (unless (and current
                          (equal old-panes (remove-if-not (lambda (id) (member id old-panes :test #'equal))
                                                         (map 'list #'libtmux:id (libtmux:panes current)))))
               (fail-workspace "Existing pane identities, parents or relative order changed" :type 'workspace-conflict))
             (unless (find id (owned-application-windows application)
                           :key (lambda (mapped) (getf mapped :physical-id)) :test #'equal)
               (unless (and (string= (libtmux:name window) (libtmux:name current))
                            (string= (libtmux:field-value window :window/layout)
                                     (libtmux:field-value current :window/layout)))
                 (fail-workspace "Unrelated window values or layout changed during application" :type 'workspace-conflict))))))

(defun owned-application-record (application snapshot)
  (let* ((declaration (slot-value (owned-application-declaration application) 'data))
         (desired (getf declaration :session)) (session (owned-application-session application snapshot))
         (writer (owned-application-writer application))
         (windows
           (map 'vector
                (lambda (wanted)
                  (let* ((mapped (owned-application-window-map application (getf wanted :id)))
                         (link (owned-application-link application mapped snapshot)) (window (libtmux:window link))
                         (panes (map 'vector
                                     (lambda (wanted-pane)
                                       (or (owned-by-id (getf wanted-pane :id) (getf mapped :panes) :logical-id)
                                           (fail-workspace "A declared logical pane has no returned identity" :type 'workspace-conflict)))
                                     (getf wanted :panes)))
                         (ids (map 'list (lambda (pane) (getf pane :physical-id)) panes))
                         (observed (remove-if-not (lambda (id) (member id ids :test #'equal))
                                                  (map 'list #'libtmux:id (libtmux:panes window)))))
                    (unless (and (string= (getf wanted :name) (libtmux:name window))
                                 (or (not (nth-value 1 (plist-value wanted :index)))
                                     (= (getf wanted :index) (libtmux:index link)))
                                 (equal ids observed)
                                 (string= (getf mapped :layout) (libtmux:field-value window :window/layout)))
                      (fail-workspace "Observed window properties, owned order or realized layout do not match" :type 'workspace-conflict))
                    (list :logical-id (getf wanted :id) :physical-id (libtmux:id window)
                          :session-id (libtmux:id session) :index (libtmux:index link) :name (libtmux:name window)
                          :layout (libtmux:field-value window :window/layout) :panes panes)))
                (getf desired :windows))))
    (unless (string= (getf desired :name) (libtmux:name session))
      (fail-workspace "Observed session name does not match the declaration" :type 'workspace-conflict))
    (make-owned-record
     :committed
     (list :schema "libtmux.lisp.workspace.owned/1" :workspace (getf declaration :id)
           :revision (slot-value writer 'token) :daemon (owned-graph-daemon snapshot) :declaration declaration
           :session (list :logical-id (getf desired :id) :physical-id (libtmux:id session) :name (libtmux:name session))
           :windows windows :previous (let ((header (owned-initial-header application)))
                                       (when header (owned-record-reference header)))
           :pending (owned-record-reference (owned-record-header (slot-value writer 'pending)))))))

(defun verify-application-geometry (application geometry)
  (dolist (id (owned-application-geometry-effects application))
    (let ((window (owned-by-id id (getf geometry :windows) :window-id)))
      (unless (and window (getf window :regular-p))
        (fail-workspace "Changed window no longer has complete regular geometry" :type 'workspace-conflict)))))

(defun verify-owned-application (application &key candidate)
  "Verify records, mappings and preserved state under BUSY or the published IDLE token."
  (let* ((writer (owned-application-writer application))
         (old-header (owned-initial-header application))
         (pending (slot-value writer 'pending)))
    (call-with-owned-application-reader
     application
     (lambda (reader)
       (let ((headers nil))
         (when old-header
           (multiple-value-bind (record header)
               (owned-read-bundle reader :committed (getf old-header :revision) (owned-record-reference old-header))
             (unless (owned-value= (slot-value record 'data)
                                  (getf (slot-value (owned-application-state application) 'data) :committed))
               (fail-workspace "Previous committed baseline changed" :type 'workspace-conflict))
             (if (eq :published (slot-value writer 'stage))
                 (setf (owned-reader-previous reader) record)
                 (setf (owned-reader-committed reader) record))
             (push header headers)))
         (multiple-value-bind (record header)
             (owned-read-bundle reader :pending (slot-value writer 'token) (owned-record-reference (owned-record-header pending)))
           (unless (string= (slot-value record 'json) (slot-value pending 'json))
             (fail-workspace "Published intent differs from the prepared declaration" :type 'workspace-conflict))
           (setf (owned-reader-pending reader) record) (push header headers))
         (when candidate
           (multiple-value-bind (record header)
               (owned-read-bundle reader :committed (slot-value writer 'token)
                                  (owned-record-reference (owned-record-header (owned-application-candidate application))))
             (unless (string= (slot-value record 'json) (slot-value (owned-application-candidate application) 'json))
               (fail-workspace "Candidate changed before its final observation" :type 'workspace-conflict))
             (when (eq :published (slot-value writer 'stage))
               (setf (owned-reader-committed reader) record))
             (push header headers)))
         (owned-read-inventory reader) (check-owned-inventory reader headers)
         (multiple-value-bind (snapshot groups geometry) (owned-application-facts application reader)
           (declare (ignore groups))
           (verify-application-geometry application geometry)
           (verify-unrelated-application-state application snapshot)
           (let ((record (owned-application-record application snapshot)))
             (when candidate
               (unless (string= (slot-value record 'json) (slot-value (owned-application-candidate application) 'json))
                 (fail-workspace "Candidate no longer describes the verified observation" :type 'workspace-conflict)))
             (setf (owned-application-snapshot application) snapshot
                   (owned-reader-status reader)
                   (if (eq :published (slot-value writer 'stage)) :published
                       (if candidate :candidate :claimed)))
             record)))))))

(defun initialize-owned-application-mappings (application)
  (let ((initial (getf (slot-value (owned-application-state application) 'data) :committed)))
    (setf (owned-application-observed application) (slot-value (owned-application-state application) 'data)
          (owned-application-session-id application) (getf (getf initial :session) :physical-id)
          (owned-application-windows application)
          (map 'list (lambda (window)
                       (let ((copy (deep-copy window)))
                         (setf (getf copy :panes) (coerce (getf copy :panes) 'list)) copy))
               (getf initial :windows)))))

(defun apply-owned-workspace (client declaration &key reconcile cancel-token
                                                    (timeout (slot-value client 'libtmux::timeout))
                                                    (output-limit (slot-value client 'libtmux::output-limit))
                                                    total-timeout)
  "Apply private workspace/2 through fresh IDs, then publish once; never replay failed effects."
  (check-type client libtmux:client)
  (check-type declaration owned-declaration)
  (libtmux.internal::check-limits timeout output-limit)
  (when total-timeout (libtmux.internal::check-limits total-timeout output-limit))
  (let* ((deadline (when total-timeout (+ (libtmux.internal::monotonic-seconds) total-timeout)))
         (options (list :cancel-token cancel-token :timeout timeout :output-limit output-limit))
         (application (make-owned-application :client client :declaration declaration :options options
                                              :deadline deadline :reconcile reconcile))
         (completed nil))
    (unwind-protect
         (handler-case
             (progn
               (setf (owned-application-state application)
                     (apply #'fetch-owned-state client declaration (workspace-call-options client options deadline))
                     (owned-application-snapshot application) (owned-state-snapshot (owned-application-state application)))
               (initialize-owned-application-mappings application)
               (setf (owned-application-phase application) :plan
                     (owned-application-plan application)
                     (plan-owned-workspace declaration (owned-application-state application) :reconcile reconcile)
                     (owned-application-initial-plan application) (owned-application-plan application))
               (check-workspace-deadline client deadline)
               (when (getf (slot-value (owned-application-plan application) 'data) :publish-p)
                 (setf (owned-application-phase application) :prepare
                       (owned-application-writer application)
                         (prepare-owned-writer
                          client declaration (owned-application-state application)
                          :cancel-token cancel-token :timeout timeout :output-limit output-limit :deadline deadline
                          :application-preconditions
                          (when (owned-application-session-id application)
                            (list (owned-session-precondition (owned-application-session application))))))
                 (let ((writer (owned-application-writer application)))
                   (setf (owned-application-phase application) :claim) (claim-owned-writer writer)
                   (setf (owned-application-phase application) :recheck) (recheck-owned-application application)
                   (setf (owned-application-phase application) :retire) (retire-owned-writer-records writer)
                   (setf (owned-application-phase application) :intent) (write-owned-writer-pending writer)
                   (setf (owned-application-phase application) :execute)
                   (map nil (lambda (step)
                              (setf (owned-application-step application) step)
                              (execute-owned-step application step))
                        (owned-plan-steps (owned-application-plan application)))
                   (setf (owned-application-step application) nil (owned-application-phase application) :verify
                         (owned-application-candidate application) (verify-owned-application application))
                   (setf (owned-application-phase application) :candidate)
                   (write-owned-writer-record writer (owned-application-candidate application))
                   (verify-owned-application application :candidate t)
                   (setf (owned-application-phase application) :publish)
                   (handler-case
                       (setf (owned-application-publication application) (publish-owned-writer writer))
                     (libtmux:libtmux-error (cause)
                       (setf (owned-application-publication application) (libtmux:error-outcome cause)) (error cause)))
                   (setf (owned-application-phase application) :observe)
                   (verify-owned-application application :candidate t)))
               (setf (owned-application-status application) (if (owned-application-publication application) :published :unchanged)
                     (owned-application-phase application) :done)
               (prog1 (make-instance 'owned-result :data (owned-application-data application)
                                      :snapshot (owned-application-snapshot application)
                                      :outcomes (owned-application-outcomes application))
                 (setf completed t)))
           (error (cause)
             (setf (owned-application-status application) :failed)
             (when (owned-application-writer application) (setf (slot-value (owned-application-writer application) 'stage) :failed))
             (error 'owned-apply-error :client client :cause cause
                    :outcome (when (typep cause 'libtmux:libtmux-error) (libtmux:error-outcome cause))
                    :data (owned-application-data application cause) :snapshot (owned-application-snapshot application)
                    :outcomes (owned-application-outcomes application cause)
                    :message "Owned workspace application stopped; inspect its phase, mappings and outcomes")))
      (unless (or completed (null (owned-application-writer application)))
        (setf (slot-value (owned-application-writer application) 'stage) :failed)))))
