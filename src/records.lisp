(in-package #:libtmux.internal)

(defstruct (row-spec (:constructor make-row-spec (name tag command fields)))
  name tag command fields)
(defstruct (capture-row (:constructor make-capture-row (spec values present)))
  spec values present)

(defparameter *row-specs*
  (loop for (name tag command formats) in
        '((:witness "witness/1" ("list-commands")
           ("pid" "start_time" "socket_path" "version"))
          (:session "session/1" ("list-sessions")
           ("session_id" "session_name" "session_created" "session_attached" "session_windows"))
          (:window-link "window-link/1" ("list-windows" "-a")
           ("session_id" "window_index" "window_id" "window_name" "window_width"
            "window_height" "window_panes" "window_active" "window_layout"))
          (:pane "pane/1" ("list-panes" "-a")
           ("session_id" "window_index" "window_id" "pane_id" "pane_index"
            "pane_active" "pane_width" "pane_height" "pane_current_command"
            "pane_current_path" "pane_title" "pane_pid" "pane_dead" "pane_start_command"))
          (:client "client/1" ("list-clients")
           ("client_name" "client_pid" "client_created" "client_tty" "session_id"
            "client_control_mode" "client_readonly")))
        collect (make-row-spec name tag command
                              (map 'vector (lambda (format) (or (gethash format *format-registry*)
                                                               (error "Unknown format ~S" format)))
                                   formats))))

(defun row-spec-for (name)
  (or (find name *row-specs* :key #'row-spec-name)
      (invalid-argument "Unknown capture row ~S" name)))

(defun encoded-format (format)
  (format nil "#{s/%/%25/;s/~C/%0A/;s/~C/%0D/;s/~C/%09/:~A}"
          #\Newline #\Return #\Tab format))

(defun row-format (spec)
  (with-output-to-string (stream)
    (write-string (row-spec-tag spec) stream)
    (loop for field across (row-spec-fields spec)
          do (write-char #\Tab stream)
             (write-string (encoded-format (field-spec-format field)) stream))))

(defun row-command (name)
  (let ((spec (row-spec-for name)))
    (append '("-N") (copy-list (row-spec-command spec))
            (list "-F" (row-format spec))
            (when (eq name :witness) '("list-sessions")))))

(defun unescape-field (bytes start end)
  (let ((result (make-array (- end start) :element-type '(unsigned-byte 8)))
        (output 0) (cursor start))
    (loop while (< cursor end)
          do (let ((byte (aref bytes cursor)))
               (when (member byte '(0 9 10 13))
                 (error 'libtmux:decoding-error :message "Unescaped control byte in tmux metadata"))
               (when (= byte 37)
                 (unless (< (+ cursor 2) end)
                   (error 'libtmux:decoding-error :message "Truncated tmux field escape"))
                 (setf byte
                       (cond ((and (= (aref bytes (1+ cursor)) 50) (= (aref bytes (+ cursor 2)) 53)) 37)
                             ((and (= (aref bytes (1+ cursor)) 48) (= (aref bytes (+ cursor 2)) 65)) 10)
                             ((and (= (aref bytes (1+ cursor)) 48) (= (aref bytes (+ cursor 2)) 68)) 13)
                             ((and (= (aref bytes (1+ cursor)) 48) (= (aref bytes (+ cursor 2)) 57)) 9)
                             (t (error 'libtmux:decoding-error :message "Unknown tmux field escape"))))
                 (incf cursor 2))
               (setf (aref result output) byte)
               (incf output)
               (incf cursor)))
    (strict-text (subseq result 0 output))))

(defun decode-rows (name bytes &key (row-limit 100000) (field-limit 1048576) check-budget)
  (let* ((spec (if (row-spec-p name) name (row-spec-for name)))
         (count (length (row-spec-fields spec)))
         (rows (make-array 0 :adjustable t :fill-pointer 0)) (start 0))
    (loop while (< start (length bytes))
          for end = (position 10 bytes :start start)
          do (when (and check-budget (zerop (logand (length rows) 255))) (funcall check-budget))
             (unless end (error 'libtmux:decoding-error :message "Incomplete tmux record"))
             (when (>= (length rows) row-limit)
               (error 'libtmux:output-limit-exceeded :message "Capture row limit exceeded"))
             (let ((parts nil) (cursor start))
               (loop for separator = (or (position 9 bytes :start cursor :end end) end)
                     do (when (> (- separator cursor) field-limit)
                          (error 'libtmux:output-limit-exceeded :message "Capture field limit exceeded"))
                        (push (cons cursor separator) parts)
                        (when (> (length parts) (1+ count))
                          (error 'libtmux:decoding-error :message "Too many tmux record columns"))
                        (setf cursor (1+ separator))
                     until (= separator end))
               (setf parts (nreverse parts))
               (unless (and (= (length parts) (1+ count))
                            (equal (strict-text (subseq bytes (caar parts) (cdar parts)))
                                   (row-spec-tag spec)))
                 (error 'libtmux:decoding-error :message "Unexpected tmux record tag or column count"))
               (let ((values (make-array count)) (present (make-array count :element-type 'bit)))
                 (loop for (left . right) in (rest parts) for i from 0
                       do (multiple-value-bind (value available)
                              (decode-scalar (aref (row-spec-fields spec) i)
                                             (unescape-field bytes left right))
                            (setf (aref values i) value (bit present i) (if available 1 0))))
                 (vector-push-extend (make-capture-row spec values present) rows)))
             (setf start (1+ end)))
    (when check-budget (funcall check-budget))
    (map 'vector #'identity rows)))

(defun row-value (row key)
  (let ((position (position key (row-spec-fields (capture-row-spec row)) :key #'field-spec-key)))
    (unless position (error "Field ~S does not belong to row ~S" key row))
    (values (aref (capture-row-values row) position) (= (bit (capture-row-present row) position) 1))))
