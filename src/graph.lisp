(in-package #:libtmux.internal)

(defun inconsistent-capture (control &rest arguments)
  (error 'libtmux:incomplete-snapshot :message (apply #'format nil control arguments)
         :details (owned-data arguments)))

(defun capture-fields (row model)
  (let ((fields (make-hash-table :test 'eq)))
    (loop for field across (row-spec-fields (capture-row-spec row)) for i from 0
          when (and (eq model (field-spec-model field))
                    (= 1 (bit (capture-row-present row) i)))
            do (setf (gethash (field-spec-key field) fields)
                     (owned-data (aref (capture-row-values row) i))))
    fields))

(defun row-agrees-p (row entity)
  (loop for field across (row-spec-fields (capture-row-spec row)) for i from 0
        always (or (not (eq (field-spec-model field) (libtmux:entity-model entity)))
                   (multiple-value-bind (value present)
                       (raw-field-value entity (field-spec-key field))
                     (and (eq present (= 1 (bit (capture-row-present row) i)))
                          (equal value (aref (capture-row-values row) i)))))))

(defun relation-storage (entity field)
  (gethash field (slot-value entity 'libtmux::relations)))
(defun (setf relation-storage) (value entity field)
  (setf (gethash field (slot-value entity 'libtmux::relations)) value))

(defun build-snapshot (context generation provenance session-rows link-rows pane-rows client-rows
                        &key (entity-limit 100000) check-budget)
  (let ((snapshot (make-instance 'libtmux:snapshot :context context :generation generation
                                :provenance (owned-data provenance)))
        (sessions (make-hash-table :test 'equal))
        (windows (make-hash-table :test 'equal))
        (panes (make-hash-table :test 'equal))
        (links (make-hash-table :test 'equal))
        (context-panes (make-hash-table :test 'eq))
        (collections (make-hash-table :test 'eq))
        (total 0))
    (labels ((new (model identity row)
               (when (> (incf total) entity-limit)
                 (error 'libtmux:output-limit-exceeded :message "Capture entity limit exceeded"))
               (when (and check-budget (zerop (logand total 255))) (funcall check-budget))
               (let ((entity (make-instance
                              (ecase model (:session 'libtmux:session) (:window 'libtmux:window)
                                (:pane 'libtmux:pane) (:window-link 'libtmux:window-link)
                                (:client 'libtmux:attached-client))
                              :snapshot snapshot :model model :identity (owned-data identity)
                              :fields (capture-fields row model))))
                 (dolist (field (model-fields model))
                   (when (eq :relation (field-spec-kind field))
                     (setf (relation-storage entity (field-spec-key field)) nil)))
                 (push entity (gethash model collections))
                 entity))
             (required (table key kind)
               (or (gethash key table)
                   (inconsistent-capture "Missing captured ~A reference ~S" kind key))))
      (loop for row across session-rows for id = (row-value row :session/id)
            do (when (gethash id sessions) (inconsistent-capture "Repeated session ID ~S" id))
               (setf (gethash id sessions) (new :session id row)))
      (loop for row across link-rows
            for session-id = (row-value row :session/id)
            for index = (row-value row :link/index)
            for window-id = (row-value row :window/id)
            for key = (list session-id index)
            for session = (required sessions session-id :session)
            do (when (gethash key links) (inconsistent-capture "Repeated session/index link ~S" key))
               (let* ((existing (gethash window-id windows))
                      (window (or existing (setf (gethash window-id windows) (new :window window-id row))))
                      (link (new :window-link (list session-id index window-id) row)))
                 (when (and existing (not (row-agrees-p row existing)))
                   (inconsistent-capture "Conflicting physical window rows for ~S" window-id))
                 (setf (gethash key links) link
                       (relation-storage link :link/window) window
                       (relation-storage link :link/session) session)
                 (push link (relation-storage session :session/window-links))
                 (push link (relation-storage window :window/links))))
      (loop for row across pane-rows
            for id = (row-value row :pane/id)
            for window-id = (row-value row :window/id)
            for key = (list (row-value row :session/id) (row-value row :link/index))
            for link = (required links key :window-link)
            for window = (required windows window-id :window)
            do (unless (eq window (relation-storage link :link/window))
                 (inconsistent-capture "Pane row disagrees with link ~S" key))
               (let* ((existing (gethash id panes))
                      (pane (or existing (setf (gethash id panes) (new :pane id row)))))
                 (cond (existing
                        (unless (and (eq window (relation-storage pane :pane/window))
                                     (row-agrees-p row existing))
                          (inconsistent-capture "Conflicting physical pane rows for ~S" id)))
                       (t
                        (setf (relation-storage pane :pane/window) window)
                        (push pane (relation-storage window :window/panes))))
                 (push pane (gethash link context-panes))))
      (loop for row across client-rows for index from 0
            for session = (required sessions (row-value row :session/id) :session)
            for client = (new :client index row)
            do (setf (relation-storage client :client/session) session)
               (push client (relation-storage session :session/clients)))
      (maphash
       (lambda (model entities)
         (let ((ordered (coerce (nreverse entities) 'simple-vector)))
           (setf (gethash model (slot-value snapshot 'libtmux::collections)) ordered)
           (loop for entity across ordered
                 do (dolist (field (model-fields model))
                      (when (eq (field-spec-kind field) :relation)
                        (if (eq (field-spec-cardinality field) :many)
                            (setf (relation-storage entity (field-spec-key field))
                                  (coerce (nreverse (relation-storage entity (field-spec-key field)))
                                          'simple-vector))
                            (unless (relation-storage entity (field-spec-key field))
                              (inconsistent-capture "Missing required relation ~S on ~S"
                                                    (field-spec-key field) (libtmux:id entity)))))))))
       collections)
      (maphash
       (lambda (id session)
         (let ((links (relation-storage session :session/window-links)))
           (unless (= (length links) (raw-field-value session :session/window-link-count))
             (inconsistent-capture "Window-link count changed for session ~S" id))
           (when (and (plusp (length links)) (/= 1 (count-if #'libtmux:active-p links)))
             (inconsistent-capture "Session ~S does not have exactly one active link" id))))
       sessions)
      (maphash
       (lambda (id window)
         (let ((panes (relation-storage window :window/panes)) (indexes (make-hash-table)))
           (unless (= (length panes) (raw-field-value window :window/pane-count))
             (inconsistent-capture "Pane count changed for window ~S" id))
           (when (and (plusp (length panes)) (/= 1 (count-if #'libtmux:active-p panes)))
             (inconsistent-capture "Window ~S does not have exactly one active pane" id))
           (loop for pane across panes for index = (raw-field-value pane :pane/index)
                 do (when (gethash index indexes)
                      (inconsistent-capture "Duplicate pane index ~D in window ~S" index id))
                    (setf (gethash index indexes) t))
           (loop for link across (relation-storage window :window/links)
                 unless (equal (coerce panes 'list) (nreverse (gethash link context-panes)))
                   do (inconsistent-capture "Contextual pane order disagrees for link ~S" (libtmux:id link)))))
       windows)
      (when check-budget (funcall check-budget))
      snapshot)))
