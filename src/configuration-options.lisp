(in-package #:libtmux.internal)

(defun configuration-option-profile (catalog)
  (let ((version (option-catalog-version catalog)))
    (cond ((string= version "3.4") :vis-noslash-dollar)
          ((member version '("3.5" "3.5a") :test #'string=) :vis-noslash)
          ((member version '("3.3a" "3.6" "3.6a" "3.6b" "3.7" "3.7a" "3.7b" "3.7c" "3.8")
                   :test #'string=) :direct)
          (t (error 'option-catalog-unavailable :version version
                    :message "No reviewed option print profile for this tmux catalog")))))

(defun configuration-input-field (input delimiter limit)
  "Consume one bounded field and separator; return its absolute byte slice."
  (let ((start (configuration-input-position input)))
    (loop for byte = (configuration-input-octet input)
          for size from 0
          when (= byte delimiter)
            do (return (values start (1- (configuration-input-position input))))
          when (>= size limit)
            do (error 'libtmux:output-limit-exceeded :message "Configuration field exceeds its byte limit"))))

(defun configuration-option-text (input start end limit quoted-p dollar-p)
  "Undo the selected print layer and, for strings, one inert argument token."
  (let ((bytes (configuration-input-bytes input))
        (check (lambda () (configuration-input-check input))))
    (funcall check)
    (when dollar-p
      (let ((normalized (make-array (- end start) :element-type '(unsigned-byte 8)))
            (used 0))
        (loop for index from start below end for byte = (aref bytes index)
              do (when (zerop (logand (- index start) 255)) (funcall check))
                 (when (and (= byte 36) (< (1+ index) end)
                            (configuration-dollar-identifier-p (aref bytes (1+ index))))
                   (unless (and (plusp used) (= 92 (aref normalized (1- used))))
                     (malformed-configuration))
                   (decf used))
                 (setf (aref normalized used) byte)
                 (incf used))
        (setf bytes normalized start 0 end used)))
    (funcall check)
    (if quoted-p
        (decode-argument-token bytes :start start :end end :byte-limit limit :check-budget check)
        (progn
          (when (> (- end start) limit)
            (error 'libtmux:output-limit-exceeded :message "Decoded option value exceeds its byte limit"))
          (let ((text (strict-text (subseq bytes start end))))
            (funcall check)
            text)))))

(defun configuration-decimal (text minimum maximum)
  "Read a canonical bounded decimal; avoid parsing an unbounded Lisp integer."
  (let* ((length (length text))
         (negative-p (and (plusp length) (char= #\- (char text 0))))
         (start (if negative-p 1 0))
         (digits (max (length (write-to-string (abs minimum) :base 10 :radix nil))
                      (length (write-to-string (abs maximum) :base 10 :radix nil)))))
    (unless (and (< start length) (<= (- length start) digits)
                 (or (= (- length start) 1) (char/= #\0 (char text start)))
                 (not (and negative-p (char= #\0 (char text start))))
                 (loop for index from start below length
                       always (char<= #\0 (char text index) #\9)))
      (malformed-configuration))
    (let ((value (parse-integer text)))
      (unless (<= minimum value maximum) (malformed-configuration))
      value)))

(defun configuration-option-value (spec text input)
  (case (option-spec-kind spec)
    (:number (configuration-decimal text (option-spec-minimum spec) (option-spec-maximum spec)))
    (:flag (cond ((string= text "on") t) ((string= text "off") nil)
                 (t (malformed-configuration))))
    (:choice (unless (member text (option-spec-choices spec) :test #'string=)
               (malformed-configuration))
             text)
    (:string text)
    ((:command :key :colour)
     (unless (and (or (eq (option-spec-kind spec) :command) (plusp (length text)))
                  (loop for character across text for index from 0
                        do (when (zerop (logand index 255)) (configuration-input-check input))
                        always (let ((code (char-code character))) (and (>= code 32) (/= code 127)))))
       (malformed-configuration))
     text)
    (otherwise (malformed-configuration))))

(defun configuration-option-key (catalog key input)
  "Validate canonical text and return its numeric or UTF-8 ordering witness."
  (when (zerop (length key)) (malformed-configuration))
  (configuration-input-check input)
  (let ((numeric-p (loop for character across key for index from 0
                        do (when (zerop (logand index 255)) (configuration-input-check input))
                        always (char<= #\0 character #\9))))
    (cond (numeric-p (configuration-decimal key 0 (option-catalog-numeric-key-maximum catalog)))
          ((option-catalog-string-keys-p catalog)
           (let ((bytes (encode-utf8 key))) (configuration-input-check input) bytes))
          (t (malformed-configuration)))))

(defun configuration-option-key< (left right input)
  (cond ((integerp left) (or (not (integerp right)) (< left right)))
        ((integerp right) nil)
        (t (loop for index below (min (length left) (length right))
                 for a = (aref left index) for b = (aref right index)
                 do (when (zerop (logand index 255)) (configuration-input-check input))
                 when (/= a b) do (return-from configuration-option-key< (< a b)))
           (< (length left) (length right)))))

(defun decode-configuration-option-leaf (bytes catalog name scope timestamp number
                                       &key (start 0) (end nil end-p) hooks-only
                                         (name-limit 1048576) (key-limit 1048576)
                                         (value-limit 1048576)
                                         (budget (make-configuration-decode-budget)))
  "Decode a known option/hook leaf into state, value, absolute offset and terminal.
CATALOG is the exact reviewed daemon catalog; NAME and SCOPE resolve once to its
canonical specification. Whole names cannot contain [, which tmux treats as
element syntax. HOOKS-ONLY checks command eligibility, not registration.
:PRESENT owns a scalar or fresh simple vector of (key-text . typed-value) pairs.
:ABSENT is a zero-row built-in result; :MISSING requires the exact raw user-name
diagnostic and :ERROR terminal. Other valid states end with :END. False values,
empty strings, empty command source and empty arrays remain distinct from absence.
The prefix has already charged this frame's begin. Each row or negative result
charges one shared record; consumed wire bytes are charged once. Field limits
count decoded UTF-8 octets. Cancellation and deadline checks cover decoding too.
This private parser does no I/O, leaves later hook bytes untouched, and proves
neither process success nor a public acquisition outcome."
  (unless (and (typep bytes '(vector (unsigned-byte 8)))
               (option-catalog-p catalog)
               (eq catalog (configuration-catalog (option-catalog-version catalog)))
               (stringp name) (plusp (length name)) (typep name-limit '(integer 1))
               (typep key-limit '(integer 0)) (typep value-limit '(integer 0))
               (typep timestamp '(signed-byte 64)) (typep number '(unsigned-byte 32)))
    (invalid-argument "Invalid option leaf, catalog, name, tuple or field limit"))
  (when (> (length name) name-limit)
    (error 'libtmux:output-limit-exceeded :message "Option name exceeds its byte limit"))
  (when (find #\[ name)
    (invalid-argument "Whole-name option reads cannot contain [ element syntax"))
  (unless end-p (setf end (length bytes)))
  (let* ((input (make-configuration-input bytes start end budget))
         (spec (catalog-option catalog name scope :hooks-only hooks-only))
         (name-bytes (encode-utf8 (option-spec-name spec)))
         (canonical-name (strict-text name-bytes))
         (user-p (= 64 (aref name-bytes 0)))
         (array-p (option-spec-array-p spec))
         (formatted-p (option-catalog-formatted-p catalog))
         (profile (configuration-option-profile catalog))
         (end-line (format nil "%end ~D ~D 0~%" timestamp number))
         (error-line (format nil "%error ~D ~D 0~%" timestamp number))
         (rows 0) (empty-array-p nil) (scalar nil) (entries nil) (previous-key nil))
    (when (> (length name-bytes) name-limit)
      (error 'libtmux:output-limit-exceeded :message "Option name exceeds its byte limit"))
    (labels ((check () (configuration-input-check input))
             (literal (text) (configuration-input-literal input text))
             (expect (byte) (unless (= byte (configuration-input-octet input)) (malformed-configuration)))
             (text-field (delimiter limit quoted-p dollar-p)
               (multiple-value-bind (from to)
                   (configuration-input-field input delimiter (+ 2 (* (if quoted-p 4 2) limit)))
                 (configuration-option-text input from to limit quoted-p dollar-p)))
             (typed-value (quoted-p dollar-p)
               (let ((text (text-field 10 value-limit quoted-p dollar-p)))
                 (check)
                 (prog1 (configuration-option-value spec text input) (check))))
             (old-row ()
               (configuration-input-name input name-bytes profile)
               (cond
                 ((and array-p (= 10 (configuration-input-peek input)))
                  (expect 10) (values nil nil t))
                 (array-p
                  (expect 91)
                  (let ((key (text-field 93 key-limit nil nil)))
                    (expect 32)
                    (values key (typed-value (eq :string (option-spec-kind spec))
                                            (eq profile :vis-noslash-dollar)) nil)))
                 (t (expect 32)
                    (values nil (typed-value (eq :string (option-spec-kind spec))
                                             (eq profile :vis-noslash-dollar)) nil))))
             (formatted-row ()
               (literal "libtmux-option/1") (expect 9)
               (let* ((actual-name (text-field 9 name-limit t nil))
                      (key (text-field 9 key-limit t nil))
                      (flags (make-array 7)))
                 (dotimes (index 7)
                   (let ((byte (configuration-input-octet input)))
                     (unless (member byte '(48 49)) (malformed-configuration))
                     (setf (aref flags index) (- byte 48))
                     (expect 9)))
                 (let ((text (text-field 10 value-limit t nil))
                       (has-key (aref flags 0)) (has-value (aref flags 1)))
                   (unless (and (string= actual-name canonical-name)
                                (= 0 (aref flags 2))
                                (= (if array-p 1 0) (aref flags 3))
                                (= (if (eq :string (option-spec-kind spec)) 1 0) (aref flags 4))
                                (= (if (option-spec-hook-p spec) 1 0) (aref flags 5))
                                (= (if user-p 1 0) (aref flags 6)))
                     (malformed-configuration))
                   (check)
                   (cond
                     ((and array-p (= has-key 0) (= has-value 0)
                           (zerop (length key)) (zerop (length text))) (values nil nil t))
                     ((and array-p (= has-key 1) (= has-value 1) (plusp (length key)))
                      (values key (configuration-option-value spec text input) nil))
                     ((and (not array-p) (= has-key 0) (= has-value 1) (zerop (length key)))
                      (values nil (configuration-option-value spec text input) nil))
                     (t (malformed-configuration))))))
             (finish (state value terminal)
               (literal (if (eq terminal :end) end-line error-line))
               (check)
               (values state value (configuration-input-position input) terminal)))
      (check)
      (loop
        (when (configuration-input-matches-p input end-line)
          (when (zerop rows)
            (when user-p (malformed-configuration))
            (configuration-input-record input))
          (return (finish (if (zerop rows) :absent :present)
                          (when (plusp rows) (if array-p (coerce (nreverse entries) 'simple-vector) scalar))
                          :end)))
        (when (and user-p (zerop rows) (configuration-input-matches-p input "invalid option: "))
          (configuration-input-record input)
          (literal "invalid option: ") (literal name-bytes) (expect 10)
          (return (finish :missing nil :error)))
        (when (and (plusp rows) (or empty-array-p (not array-p))) (malformed-configuration))
        (configuration-input-record input)
        (multiple-value-bind (key value empty-p) (if formatted-p (formatted-row) (old-row))
          (when (and empty-p (plusp rows)) (malformed-configuration))
          (setf empty-array-p empty-p)
          (unless empty-p
            (if array-p
                (let ((order-key (configuration-option-key catalog key input)))
                  (when (and previous-key (not (configuration-option-key< previous-key order-key input)))
                    (malformed-configuration))
                  (setf previous-key order-key)
                  (push (cons key value) entries))
                (setf scalar value)))
          (incf rows)
          (check))))))
