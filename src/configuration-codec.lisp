(in-package #:libtmux.internal)

(defun decode-argument-token (bytes &key (start 0) (end nil end-p)
                                       (byte-limit 1048576) check-budget)
  "Decode one args_escape data value without reader or command interpretation."
  (unless (typep bytes '(vector (unsigned-byte 8)))
    (invalid-argument "Quoted data must be an octet vector"))
  (unless end-p (setf end (length bytes)))
  (unless (and
               (typep start '(integer 0)) (typep end '(integer 0))
               (<= start end (length bytes)) (typep byte-limit '(integer 0)))
    (invalid-argument "Invalid quoted-data slice or byte limit"))
  (when check-budget (funcall check-budget))
  (when (= start end)
    (error 'libtmux:decoding-error :message "Missing tmux value token"))
  (let* ((quote (and (member (aref bytes start) '(34 39)) (aref bytes start)))
         (cursor (if quote (1+ start) start))
         (limit (if quote (1- end) end))
         (next-check (+ cursor 256))
         (output nil)
         (used 0))
    (unless (or (null quote) (and (<= cursor limit) (= quote (aref bytes limit))))
      (error 'libtmux:decoding-error :message "Unclosed tmux value quote"))
    (setf output (make-array (min byte-limit (- limit cursor)) :element-type '(unsigned-byte 8)))
    (labels ((malformed () (error 'libtmux:decoding-error :message "Malformed tmux value escape or quoting"))
             (emit (byte)
               (unless (<= 1 byte 255) (malformed))
               (when (>= used byte-limit)
                 (error 'libtmux:output-limit-exceeded :message "Decoded tmux value exceeds its byte limit"))
               (setf (aref output used) byte)
               (incf used)))
      (loop while (< cursor limit)
            do (when (and check-budget (>= cursor next-check))
                 (funcall check-budget)
                 (incf next-check 256))
               (let ((byte (aref bytes cursor)))
                 (incf cursor)
                 (if (/= byte 92)
                     (progn
                       (when (or (< byte 32) (= byte 127) (eql byte quote)
                                 (and (null quote) (member byte '(32 34 39))))
                         (malformed))
                       (emit byte))
                     (progn
                       (when (>= cursor limit) (malformed))
                       (let ((escaped (aref bytes cursor)))
                         (incf cursor)
                         (emit
                          (case escaped
                            (110 10) (114 13) (98 8) (97 7) (116 9) (118 11) (102 12) (115 32)
                            ((92 34 39 36 123 125 37 35 59 126) escaped)
                            (otherwise
                             (unless (and (<= 48 escaped 55) (< (1+ cursor) limit)
                                          (<= 48 (aref bytes cursor) 55)
                                          (<= 48 (aref bytes (1+ cursor)) 55))
                               (malformed))
                             (prog1 (+ (* 64 (- escaped 48))
                                       (* 8 (- (aref bytes cursor) 48))
                                       (- (aref bytes (1+ cursor)) 48))
                               (incf cursor 2))))))))))
      (when check-budget (funcall check-budget))
      (let ((text (strict-text (subseq output 0 used))))
        (when check-budget (funcall check-budget))
        text))))

(defstruct configuration-decode-budget
  "One acquisition's cumulative decoding allowance, distinct from wire limits."
  (remaining-bytes 1048576) (remaining-frames 4096) check)

(defun decode-configuration-prefix (bytes nonce target-count
                                    &key (start 0) (end nil end-p)
                                      (budget (make-configuration-decode-budget)))
  "Decode only the guarded prefix; return disposition/offset/time/counter.
The Linux x86_64 profile uses signed 64-bit times, unsigned 32-bit counters
and flags zero. :LEAF stops just after its begin header; the caller must parse
that leaf's schema before its terminator. :SERVER-REFUSED/:TARGET-REFUSED stop
after the exact marker's closing frame. Offsets are absolute within BYTES.
Trailing bytes remain untouched. BUDGET is shared with later decoders. Each
begin header charges one frame, including marker and leaf headers; only
consumed prefix bytes reduce its byte allowance. Its CHECK callback enforces
the acquisition's existing deadline/cancellation."
  (unless (typep bytes '(vector (unsigned-byte 8)))
    (invalid-argument "Control prefix must be an octet vector"))
  (unless end-p (setf end (length bytes)))
  (unless (and (typep start '(integer 0)) (typep end '(integer 0))
               (<= start end (length bytes)) (typep target-count '(integer 0 4096))
               (stringp nonce) (<= 1 (length nonce) 64)
               (every (lambda (character)
                        (or (char<= #\a character #\z) (char<= #\A character #\Z)
                            (char<= #\0 character #\9) (find character "_-"))) nonce)
               (configuration-decode-budget-p budget)
               (typep (configuration-decode-budget-remaining-bytes budget) '(integer 0))
               (typep (configuration-decode-budget-remaining-frames budget) '(integer 0))
               (or (null (configuration-decode-budget-check budget))
                   (functionp (configuration-decode-budget-check budget))))
    (invalid-argument "Invalid control-prefix slice, nonce, guard count or budget"))
  (let ((cursor start) (next-check (+ start 256)) (nonce (copy-seq nonce)))
    (labels ((malformed ()
               (error 'libtmux:decoding-error :message "Malformed guarded control prefix"))
             (check ()
               (when (configuration-decode-budget-check budget)
                 (funcall (configuration-decode-budget-check budget))))
             (peek ()
               (when (>= cursor end) (malformed))
               (aref bytes cursor))
             (octet ()
               (let ((byte (peek)))
                 (unless (plusp (configuration-decode-budget-remaining-bytes budget))
                   (error 'libtmux:output-limit-exceeded :message "Control decoding byte budget exhausted"))
                 (decf (configuration-decode-budget-remaining-bytes budget))
                 (incf cursor)
                 (when (>= cursor next-check)
                   (check)
                   (setf next-check (+ cursor 256)))
                 byte))
             (expect (byte) (unless (= byte (octet)) (malformed)))
             (literal (text) (loop for character across text do (expect (char-code character))))
             (decimal (signed-p)
               (let* ((negative (and signed-p (= (peek) 45)))
                      (limit (if signed-p (if negative 9223372036854775808 9223372036854775807)
                                 4294967295))
                      (number 0) (first t) (zero nil))
                 (when negative (octet))
                 (unless (<= 48 (peek) 57) (malformed))
                 (loop while (and (< cursor end) (<= 48 (aref bytes cursor) 57))
                       do (when (and (not first) zero) (malformed))
                          (let ((digit (- (octet) 48)))
                            (when first (setf zero (zerop digit) first nil))
                            (setf number (+ (* number 10) digit))
                            (when (> number limit) (malformed))))
                 (when (and negative (zerop number)) (malformed))
                 (if negative (- number) number)))
             (header (prefix)
               (literal prefix)
               (let ((timestamp (decimal t)))
                 (expect 32)
                 (let ((number (decimal nil)))
                   (expect 32) (expect 48) (expect 10)
                   (values timestamp number))))
             (begin-frame ()
               (check)
               (unless (plusp (configuration-decode-budget-remaining-frames budget))
                 (error 'libtmux:output-limit-exceeded :message "Control decoding frame budget exhausted"))
               (decf (configuration-decode-budget-remaining-frames budget))
               (header "%begin "))
             (finish-frame (timestamp number)
               (multiple-value-bind (actual-time actual-number) (header "%end ")
                 (unless (and (= timestamp actual-time) (= number actual-number)) (malformed)))))
      (check)
      (multiple-value-bind (timestamp number) (begin-frame)
        (finish-frame timestamp number))
      (loop with completed-targets = 0
            do (multiple-value-bind (timestamp number) (begin-frame)
                 (if (= 37 (peek))
                     (progn
                       (unless (< completed-targets target-count) (malformed))
                       (finish-frame timestamp number)
                       (incf completed-targets))
                     (progn
                       (literal nonce)
                       (expect 58)
                       (let ((marker (case (peek)
                                       (115 (literal "server") :server)
                                       (116 (literal "target") :target)
                                       (108 (literal "leaf") :leaf)
                                       (otherwise (malformed)))))
                         (expect 10)
                         (finish-frame timestamp number)
                         (unless (case marker
                                   (:server (zerop completed-targets))
                                   (:target (plusp completed-targets))
                                   (:leaf (= completed-targets target-count)))
                           (malformed))
                         (when (eq marker :leaf)
                           (multiple-value-setq (timestamp number) (begin-frame)))
                         (check)
                         (return (values (ecase marker
                                           (:server :server-refused)
                                           (:target :target-refused)
                                           (:leaf :leaf))
                                         cursor timestamp number))))))))))
