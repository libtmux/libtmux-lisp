(in-package #:libtmux.internal)

(defun decode-argument-token (bytes &key (start 0) (end nil end-p)
                                       (byte-limit 1048576) check-budget)
  "Decode one args_escape data value without reader or command interpretation."
  (unless (typep bytes '(vector (unsigned-byte 8)))
    (invalid-argument "Quoted data must be an octet vector"))
  (unless end-p (setf end (length bytes)))
  (unless (and
               (typep start '(integer 0)) (typep end '(integer 0))
               (<= start end (length bytes)) (typep byte-limit '(integer 0)))
    (invalid-argument "Invalid quoted-data slice or byte limit"))
  (when check-budget (funcall check-budget))
  (when (= start end)
    (error 'libtmux:decoding-error :message "Missing tmux value token"))
  (let* ((quote (and (member (aref bytes start) '(34 39)) (aref bytes start)))
         (cursor (if quote (1+ start) start))
         (limit (if quote (1- end) end))
         (next-check (+ cursor 256))
         (output nil)
         (used 0))
    (unless (or (null quote) (and (<= cursor limit) (= quote (aref bytes limit))))
      (error 'libtmux:decoding-error :message "Unclosed tmux value quote"))
    (setf output (make-array (min byte-limit (- limit cursor)) :element-type '(unsigned-byte 8)))
    (labels ((malformed () (error 'libtmux:decoding-error :message "Malformed tmux value escape or quoting"))
             (emit (byte)
               (unless (<= 1 byte 255) (malformed))
               (when (>= used byte-limit)
                 (error 'libtmux:output-limit-exceeded :message "Decoded tmux value exceeds its byte limit"))
               (setf (aref output used) byte)
               (incf used)))
      (loop while (< cursor limit)
            do (when (and check-budget (>= cursor next-check))
                 (funcall check-budget)
                 (incf next-check 256))
               (let ((byte (aref bytes cursor)))
                 (incf cursor)
                 (if (/= byte 92)
                     (progn
                       (when (or (< byte 32) (= byte 127) (eql byte quote)
                                 (and (null quote) (member byte '(32 34 39))))
                         (malformed))
                       (emit byte))
                     (progn
                       (when (>= cursor limit) (malformed))
                       (let ((escaped (aref bytes cursor)))
                         (incf cursor)
                         (emit
                          (case escaped
                            (110 10) (114 13) (98 8) (97 7) (116 9) (118 11) (102 12) (115 32)
                            ((92 34 39 36 123 125 37 35 59 126) escaped)
                            (otherwise
                             (unless (and (<= 48 escaped 55) (< (1+ cursor) limit)
                                          (<= 48 (aref bytes cursor) 55)
                                          (<= 48 (aref bytes (1+ cursor)) 55))
                               (malformed))
                             (prog1 (+ (* 64 (- escaped 48))
                                       (* 8 (- (aref bytes cursor) 48))
                                       (- (aref bytes (1+ cursor)) 48))
                               (incf cursor 2))))))))))
      (when check-budget (funcall check-budget))
      (let ((text (strict-text (subseq output 0 used))))
        (when check-budget (funcall check-budget))
        text))))

(defstruct configuration-decode-budget
  "One acquisition's cumulative decoding allowance, distinct from wire limits."
  (remaining-bytes 1048576) (remaining-frames 4096) check)

(defstruct (configuration-input (:constructor %make-configuration-input))
  "Private bounded cursor over one operation's retained input and shared budget."
  (bytes nil :read-only t) (end 0 :read-only t) (budget nil :read-only t)
  (position 0) (next-check 256))

(defun make-configuration-input (bytes start end budget)
  (unless (and (typep bytes '(vector (unsigned-byte 8)))
               (typep start '(integer 0)) (typep end '(integer 0))
               (<= start end (length bytes))
               (configuration-decode-budget-p budget)
               (typep (configuration-decode-budget-remaining-bytes budget) '(integer 0))
               (typep (configuration-decode-budget-remaining-frames budget) '(integer 0))
               (or (null (configuration-decode-budget-check budget))
                   (functionp (configuration-decode-budget-check budget))))
    (invalid-argument "Invalid configuration input slice or shared budget"))
  (%make-configuration-input :bytes bytes :end end :budget budget
                             :position start :next-check (+ start 256)))

(defun malformed-configuration ()
  (error 'libtmux:decoding-error :message "Malformed tmux configuration data"))

(defun configuration-input-check (input)
  (let ((check (configuration-decode-budget-check (configuration-input-budget input))))
    (when check (funcall check))))

(defun configuration-input-peek (input)
  (when (>= (configuration-input-position input) (configuration-input-end input))
    (malformed-configuration))
  (aref (configuration-input-bytes input) (configuration-input-position input)))

(defun configuration-input-octet (input)
  (let ((byte (configuration-input-peek input)) (budget (configuration-input-budget input)))
    (unless (plusp (configuration-decode-budget-remaining-bytes budget))
      (error 'libtmux:output-limit-exceeded :message "Control decoding byte budget exhausted"))
    (decf (configuration-decode-budget-remaining-bytes budget))
    (incf (configuration-input-position input))
    (when (>= (configuration-input-position input) (configuration-input-next-check input))
      (configuration-input-check input)
      (setf (configuration-input-next-check input) (+ (configuration-input-position input) 256)))
    byte))

(defun configuration-input-literal (input expected)
  (loop with text-p = (stringp expected)
        for index below (length expected)
        for byte = (if text-p (char-code (char expected index)) (aref expected index))
        unless (= byte (configuration-input-octet input)) do (malformed-configuration)))

(defun configuration-input-matches-p (input expected &optional (position (configuration-input-position input)))
  "Bounded lookahead only; consumption, not lookahead, spends the byte allowance."
  (configuration-input-check input)
  (and (<= (+ position (length expected)) (configuration-input-end input))
       (loop with text-p = (stringp expected)
             for index below (length expected)
             always (progn
                      (when (zerop (logand index 255)) (configuration-input-check input))
                      (= (aref (configuration-input-bytes input) (+ position index))
                         (if text-p (char-code (char expected index)) (aref expected index)))))))

(defun decode-configuration-prefix (bytes nonce target-count
                                    &key (start 0) (end nil end-p)
                                      (budget (make-configuration-decode-budget)))
  "Decode only the guarded prefix; return disposition/offset/time/counter.
The Linux x86_64 profile uses signed 64-bit times, unsigned 32-bit counters
and flags zero. :LEAF stops just after its begin header; the caller must parse
that leaf's schema before its terminator. :SERVER-REFUSED/:TARGET-REFUSED stop
after the exact marker's closing frame. Offsets are absolute within BYTES.
Trailing bytes remain untouched. BUDGET is shared with later decoders. Each
begin header charges one frame, including marker and leaf headers; only
consumed prefix bytes reduce its byte allowance. Its CHECK callback enforces
the acquisition's existing deadline/cancellation."
  (unless (typep bytes '(vector (unsigned-byte 8)))
    (invalid-argument "Control prefix must be an octet vector"))
  (unless end-p (setf end (length bytes)))
  (unless (and (typep start '(integer 0)) (typep end '(integer 0))
               (<= start end (length bytes)) (typep target-count '(integer 0 4096))
               (stringp nonce) (<= 1 (length nonce) 64)
               (every (lambda (character)
                        (or (char<= #\a character #\z) (char<= #\A character #\Z)
                            (char<= #\0 character #\9) (find character "_-"))) nonce)
               (configuration-decode-budget-p budget)
               (typep (configuration-decode-budget-remaining-bytes budget) '(integer 0))
               (typep (configuration-decode-budget-remaining-frames budget) '(integer 0))
               (or (null (configuration-decode-budget-check budget))
                   (functionp (configuration-decode-budget-check budget))))
    (invalid-argument "Invalid control-prefix slice, nonce, guard count or budget"))
  (let ((input (make-configuration-input bytes start end budget)) (nonce (copy-seq nonce)))
    (labels ((malformed ()
               (error 'libtmux:decoding-error :message "Malformed guarded control prefix"))
             (check () (configuration-input-check input))
             (peek () (configuration-input-peek input))
             (octet () (configuration-input-octet input))
             (expect (byte) (unless (= byte (octet)) (malformed)))
             (literal (text) (configuration-input-literal input text))
             (decimal (signed-p)
               (let* ((negative (and signed-p (= (peek) 45)))
                      (limit (if signed-p (if negative 9223372036854775808 9223372036854775807)
                                 4294967295))
                      (number 0) (first t) (zero nil))
                 (when negative (octet))
                 (unless (<= 48 (peek) 57) (malformed))
                 (loop while (and (< (configuration-input-position input) end)
                                  (<= 48 (aref bytes (configuration-input-position input)) 57))
                       do (when (and (not first) zero) (malformed))
                          (let ((digit (- (octet) 48)))
                            (when first (setf zero (zerop digit) first nil))
                            (setf number (+ (* number 10) digit))
                            (when (> number limit) (malformed))))
                 (when (and negative (zerop number)) (malformed))
                 (if negative (- number) number)))
             (header (prefix)
               (literal prefix)
               (let ((timestamp (decimal t)))
                 (expect 32)
                 (let ((number (decimal nil)))
                   (expect 32) (expect 48) (expect 10)
                   (values timestamp number))))
             (begin-frame ()
               (check)
               (unless (plusp (configuration-decode-budget-remaining-frames budget))
                 (error 'libtmux:output-limit-exceeded :message "Control decoding frame budget exhausted"))
               (decf (configuration-decode-budget-remaining-frames budget))
               (header "%begin "))
             (finish-frame (timestamp number)
               (multiple-value-bind (actual-time actual-number) (header "%end ")
                 (unless (and (= timestamp actual-time) (= number actual-number)) (malformed)))))
      (check)
      (multiple-value-bind (timestamp number) (begin-frame)
        (finish-frame timestamp number))
      (loop with completed-targets = 0
            do (multiple-value-bind (timestamp number) (begin-frame)
                 (if (= 37 (peek))
                     (progn
                       (unless (< completed-targets target-count) (malformed))
                       (finish-frame timestamp number)
                       (incf completed-targets))
                     (progn
                       (literal nonce)
                       (expect 58)
                       (let ((marker (case (peek)
                                       (115 (literal "server") :server)
                                       (116 (literal "target") :target)
                                       (108 (literal "leaf") :leaf)
                                       (otherwise (malformed)))))
                         (expect 10)
                         (finish-frame timestamp number)
                         (unless (case marker
                                   (:server (zerop completed-targets))
                                   (:target (plusp completed-targets))
                                   (:leaf (= completed-targets target-count)))
                           (malformed))
                         (when (eq marker :leaf)
                           (multiple-value-setq (timestamp number) (begin-frame)))
                         (check)
                         (return (values (ecase marker
                                           (:server :server-refused)
                                           (:target :target-refused)
                                           (:leaf :leaf))
                                         (configuration-input-position input) timestamp number))))))))))

(define-condition ambiguous-environment-frame (libtmux:decoding-error)
  ((timestamp :initarg :timestamp :reader environment-ambiguity-timestamp)
   (number :initarg :number :reader environment-ambiguity-number))
  (:documentation "A known name overlaps its leaf terminator; no value may be inferred."))

(defun configuration-dollar-identifier-p (byte)
  (and byte (or (<= 65 byte 90) (<= 97 byte 122) (= byte 95) (= byte 123))))

(defun visit-configuration-environment-name (name profile emit check)
  "Forward-print one known UTF-8 name without allocating an expanded copy."
  (let ((used 0))
    (labels ((put (byte)
               (when (zerop (logand used 255)) (funcall check))
               (incf used)
               (funcall emit byte)))
      (loop for index below (length name)
            for byte = (aref name index)
            do (cond
                 ((eq profile :direct) (put byte))
                 ((and (eq profile :vis-noslash-dollar) (= byte 36)
                       (< (1+ index) (length name))
                       (configuration-dollar-identifier-p (aref name (1+ index))))
                  (put 92) (put byte))
                 ((or (and (< byte 32) (not (member byte '(9 10)))) (= byte 127))
                  (put 92)
                  (let ((style (case byte (7 97) (8 98) (11 118) (12 102) (13 114))))
                    (if style (put style)
                        (progn (put (+ 48 (ldb (byte 3 6) byte)))
                               (put (+ 48 (ldb (byte 3 3) byte)))
                               (put (+ 48 (ldb (byte 3 0) byte)))))))
                 (t (put byte))))
      (funcall check)
      used)))

(defun configuration-input-name-match (input name profile)
  "Look ahead through one known name; return its matching absolute end index."
  (let ((position (configuration-input-position input)))
    (visit-configuration-environment-name
     name profile
     (lambda (byte)
       (unless (and (< position (configuration-input-end input))
                    (= byte (aref (configuration-input-bytes input) position)))
         (return-from configuration-input-name-match (values nil position)))
       (incf position))
     (lambda () (configuration-input-check input)))
    (values t position)))

(defun configuration-name-overlaps-end-p (input name profile end-line)
  (let ((index 0))
    (visit-configuration-environment-name
     name profile
     (lambda (byte)
       (unless (= byte (char-code (char end-line index)))
         (return-from configuration-name-overlaps-end-p nil))
       (incf index)
       (when (= index (length end-line))
         (return-from configuration-name-overlaps-end-p t)))
     (lambda () (configuration-input-check input)))
    nil))

(defun configuration-input-name (input name profile)
  (visit-configuration-environment-name
   name profile
   (lambda (byte)
     (unless (= byte (configuration-input-octet input)) (malformed-configuration)))
   (lambda () (configuration-input-check input))))

(defun decode-configuration-environment-leaf (bytes name timestamp number
                                            &key (profile :direct) (start 0) (end nil end-p)
                                              (value-limit 1048576) (name-limit 1048576)
                                              (budget (make-configuration-decode-budget)))
  "Decode one known UTF-8 environment leaf; return state/value/offset/terminal.
NAME is native UTF-8 octets, not the narrower mutation identifier grammar.
PROFILE is :DIRECT, :VIS-NOSLASH or :VIS-NOSLASH-DOLLAR, selected from reviewed
UTF-8-client/source facts. :PRESENT owns its string, including empty text;
:REMOVED, :EMPTY visibility and exact :MISSING diagnostics return NIL values.
Only :MISSING ends with :ERROR; other results end with :END. Offsets are absolute
and trailing hook bytes remain untouched. This parser does no I/O and establishes
no successful public absence or process outcome. Name/frame collisions signal
AMBIGUOUS-ENVIRONMENT-FRAME for the acquisition owner to resolve separately.
The prefix already charged this leaf begin. BUDGET shares consumed-byte charges
and cancellation/deadline checks; VALUE-LIMIT counts decoded octets."
  (unless (typep bytes '(vector (unsigned-byte 8)))
    (invalid-argument "Environment leaf must be an octet vector"))
  (unless end-p (setf end (length bytes)))
  (unless (and (typep name '(vector (unsigned-byte 8)))
               (typep name-limit '(integer 1)) (<= 1 (length name) name-limit)
               (typep value-limit '(integer 0)) (typep timestamp '(signed-byte 64))
               (typep number '(unsigned-byte 32))
               (member profile '(:direct :vis-noslash :vis-noslash-dollar)))
    (invalid-argument "Invalid environment name, tuple, print profile or value limit"))
  (let ((input (make-configuration-input bytes start end budget))
        (name (copy-seq name))
        (end-line (format nil "%end ~D ~D 0~%" timestamp number))
        (error-line (format nil "%error ~D ~D 0~%" timestamp number)))
    (labels ((check () (configuration-input-check input))
             (literal (value) (configuration-input-literal input value))
             (octet () (configuration-input-octet input))
             (next-byte (&optional (offset 0))
               (let ((at (+ (configuration-input-position input) offset)))
                 (when (< at end) (aref bytes at))))
             (finish (state value terminal)
               (literal (if (eq terminal :end) end-line error-line))
               (check)
               (values state value (configuration-input-position input) terminal))
             (value-text ()
               (let ((output (make-array (min 64 value-limit) :element-type '(unsigned-byte 8)
                                                               :adjustable t :fill-pointer 0)))
                 (labels ((emit (byte)
                            (when (>= (fill-pointer output) value-limit)
                              (error 'libtmux:output-limit-exceeded :message "Environment value exceeds its byte limit"))
                            (when (= (fill-pointer output) (array-total-size output))
                              (check)
                              (setf output (adjust-array output
                                            (min value-limit (max 1 (* 2 (array-total-size output)))))))
                            (vector-push byte output))
                          (escaped ()
                            (let ((byte (octet)))
                              (case byte
                                (92
                                 (if (and (eq profile :vis-noslash-dollar) (eql 36 (next-byte))
                                          (configuration-dollar-identifier-p (next-byte 1)))
                                     (progn (octet) 36) 92))
                                (36
                                 (when (and (eq profile :vis-noslash-dollar)
                                            (configuration-dollar-identifier-p (next-byte)))
                                   (malformed-configuration))
                                 36)
                                ((34 96) byte)
                                (otherwise
                                 (when (eq profile :direct) (malformed-configuration))
                                 (or (case byte (114 13) (98 8) (97 7) (118 11) (102 12))
                                     (progn
                                       (unless (<= 48 byte 55) (malformed-configuration))
                                       (let ((second (octet)) (third (octet)))
                                         (unless (and (<= 48 second 55) (<= 48 third 55))
                                           (malformed-configuration))
                                         (let ((decoded (+ (* 64 (- byte 48)) (* 8 (- second 48)) (- third 48))))
                                           (unless (or (<= 1 decoded 6) (<= 14 decoded 31) (= decoded 127))
                                             (malformed-configuration))
                                           decoded)))))))))
                   (loop for byte = (octet)
                         until (= byte 34)
                         do (cond
                              ((= byte 92) (emit (escaped)))
                              ((or (zerop byte) (member byte '(36 96))
                                   (and (not (eq profile :direct))
                                        (or (and (< byte 32) (not (member byte '(9 10)))) (= byte 127))))
                               (malformed-configuration))
                              (t (emit byte))))
                   (check)
                   (let ((text (strict-text (subseq output 0 (fill-pointer output)))))
                     (check)
                     text)))))
      (check)
      (loop for byte across name for index from 0
            do (when (zerop (logand index 255)) (check))
               (when (member byte '(0 61)) (invalid-argument "Environment name cannot contain NUL or =")))
      (strict-text name)
      (check)
      (when (configuration-input-matches-p input end-line)
        (when (configuration-name-overlaps-end-p input name profile end-line)
          (check)
          (error 'ambiguous-environment-frame :timestamp timestamp :number number
                 :message "Environment name overlaps its control terminator; this observation is ambiguous"))
        (return-from decode-configuration-environment-leaf (finish :empty nil :end)))
      (multiple-value-bind (matches name-end) (configuration-input-name-match input name profile)
        (when (and matches (configuration-input-matches-p input "=\"" name-end))
          (configuration-input-name input name profile)
          (literal "=\"")
          (let ((text (value-text)))
            (literal "; export ")
            (configuration-input-name input name profile)
            (literal (format nil ";~%"))
            (return-from decode-configuration-environment-leaf (finish :present text :end)))))
      (cond
        ((configuration-input-matches-p input "unset ")
         (literal "unset ")
         (configuration-input-name input name profile)
         (literal (format nil ";~%"))
         (finish :removed nil :end))
        ((configuration-input-matches-p input "unknown variable: ")
         (literal "unknown variable: ")
         (literal name)
         (literal (string #\Newline))
         (finish :missing nil :error))
        (t (malformed-configuration))))))
