(in-package #:libtmux.workspace)

(defclass owned-plan ()
  ((declaration :initarg :declaration) (state :initarg :state)
   (data :initarg :data) (steps :initarg :steps))
  (:documentation "Private local preview; application must acquire and plan again."))

(define-condition owned-plan-conflict (workspace-conflict)
  ((data :initarg :data))
  (:documentation "Local planning refusal retaining separate declaration and observation diagnostics."))

(defun owned-plan-data (plan) (deep-copy (slot-value plan 'data)))
(defun owned-plan-steps (plan) (copy-seq (slot-value plan 'steps)))
(defun owned-plan-error-data (condition) (deep-copy (slot-value condition 'data)))

(defstruct owned-planner declaration state changes drift conflicts context steps)

(defun owned-value= (left right)
  (cond ((and (consp left) (consp right))
         (and (owned-value= (car left) (car right)) (owned-value= (cdr left) (cdr right))))
        ((and (vectorp left) (vectorp right) (not (stringp left)) (not (stringp right)))
         (and (= (length left) (length right)) (every #'owned-value= left right)))
        (t (equal left right))))

(defun note-owned-difference (planner kind path before after)
  (unless (owned-value= before after)
    (let ((entry (deep-copy (list :path path :before before :after after))))
      (ecase kind
        (:change (push entry (owned-planner-changes planner)))
        (:drift (push entry (owned-planner-drift planner)))))))

(defun emit-owned-step (planner action &rest data)
  (push (apply #'make-step action data) (owned-planner-steps planner)))

(defun refuse-owned-plan (planner path reason)
  (push (deep-copy (list :path path :reason reason)) (owned-planner-conflicts planner)))

(defun owned-member-value (object key)
  (multiple-value-bind (value present) (plist-value object key)
    (list :present-p present :value value)))

(defun compare-owned-member (planner old wanted key path &key unsupported)
  (let ((before (owned-member-value old key)) (after (owned-member-value wanted key)))
    (unless (owned-value= before after)
      (note-owned-difference planner :change (path+ path key) before after)
      (when unsupported
        (refuse-owned-plan planner (path+ path key) "Existing creation input or logical identity changed")))))

(defun owned-by-id (id sequence &optional (key :id))
  (find id sequence :key (lambda (item) (getf item key)) :test #'string=))

(defun collect-owned-plan-context (planner)
  (let* ((state (owned-planner-state planner)) (data (slot-value state 'data))
         (snapshot (owned-state-snapshot state)) (record (getf data :committed)))
    (loop for window across (libtmux:windows snapshot)
          for id = (libtmux:id window)
          for mapped = (owned-by-id id (getf record :windows) :physical-id)
          for links = (remove-if (lambda (link) (not (string= id (libtmux:id (libtmux:window link)))))
                                 (libtmux:window-links snapshot))
          do (cond ((null mapped)
                    (push (list :kind :unmanaged-window :physical-id id
                                :links (map 'vector #'libtmux:id links)) (owned-planner-context planner)))
                   (t
                    (when (> (length links) 1)
                      (push (list :kind :shared-window :window-id (getf mapped :logical-id)
                                  :links (map 'vector #'libtmux:id links)) (owned-planner-context planner)))
                    (let ((unmanaged (remove-if (lambda (pane) (owned-by-id (libtmux:id pane) (getf mapped :panes) :physical-id))
                                                (libtmux:panes window))))
                      (when (plusp (length unmanaged))
                        (push (list :kind :unmanaged-panes :window-id (getf mapped :logical-id)
                                    :panes (map 'vector #'libtmux:id unmanaged)) (owned-planner-context planner)))))))
    (let ((group (find (getf (getf record :session) :physical-id) (getf data :groups) :key #'car :test #'equal)))
      (when (and group (cdr group))
        (push (list :kind :grouped-session :physical-id (car group)) (owned-planner-context planner))))))

(defun check-owned-declaration-edits (planner old wanted record)
  (let* ((before (getf old :session)) (after (getf wanted :session))
         (old-windows (getf before :windows)) (new-windows (getf after :windows)))
    (compare-owned-member planner old wanted :id #() :unsupported t)
    (dolist (key '(:id :cwd :environment))
      (compare-owned-member planner before after key #(:session) :unsupported t))
    (dolist (window (coerce old-windows 'list))
      (unless (owned-by-id (getf window :id) new-windows)
        (refuse-owned-plan planner (vector :windows (getf window :id)) "Removing an owned window is unsupported")))
    (note-owned-difference planner :change #(:session :windows)
                           (map 'vector (lambda (window) (getf window :id)) old-windows)
                           (map 'vector (lambda (window) (getf window :id)) new-windows))
    (loop for window across new-windows
          for id = (getf window :id)
          for previous = (owned-by-id id old-windows)
          for mapped = (owned-by-id id (getf record :windows) :logical-id)
          for path = (vector :windows id)
          when previous
            do (compare-owned-member planner previous window :cwd path :unsupported t)
               (compare-owned-member planner previous window :index path)
               (compare-owned-member planner previous window :layout path)
               (note-owned-difference planner :change (path+ path :panes)
                                      (map 'vector (lambda (pane) (getf pane :id)) (getf previous :panes))
                                      (map 'vector (lambda (pane) (getf pane :id)) (getf window :panes)))
               (when (and (nth-value 1 (plist-value window :index))
                          (/= (getf window :index) (getf mapped :index)))
                 (refuse-owned-plan planner (path+ path :index) "Moving an existing window index is unsupported"))
               (loop for pane across (getf previous :panes)
                     for pane-id = (getf pane :id)
                     for desired = (owned-by-id pane-id (getf window :panes))
                     do (if desired
                            (dolist (key '(:cwd :command :shell-command))
                              (compare-owned-member planner pane desired key (path+ path pane-id) :unsupported t))
                            (refuse-owned-plan planner (path+ path pane-id) "Removing or reparenting an owned pane is unsupported")))
               (let ((old-order (map 'list (lambda (pane) (getf pane :id)) (getf previous :panes)))
                     (retained (loop for pane across (getf window :panes)
                                     when (owned-by-id (getf pane :id) (getf previous :panes))
                                       collect (getf pane :id))))
                 (unless (equal old-order retained)
                   (refuse-owned-plan planner (path+ path :panes) "Existing panes must keep their relative order"))))))

(defun check-owned-effect-scopes (planner publication)
  (let* ((state (owned-planner-state planner)) (data (slot-value state 'data))
         (snapshot (owned-state-snapshot state)) (record (getf data :committed))
         (session-id (getf (getf record :session) :physical-id)))
    (when publication
      (let ((group (find session-id (getf data :groups) :key #'car :test #'string=)))
        (unless (and group (null (cdr group)))
          (refuse-owned-plan planner #(:session) "Material application requires a captured ungrouped session"))))
    (dolist (step (owned-planner-steps planner))
      (when (member (step-action step) '(:rename-window :split-pane :select-layout))
        (let* ((id (getf (slot-value step 'data) :window-id))
               (mapped (owned-by-id id (getf record :windows) :logical-id)))
          (when mapped
            (let* ((physical-id (getf mapped :physical-id))
                   (links (remove-if (lambda (link)
                                       (not (string= physical-id (libtmux:id (libtmux:window link)))))
                                     (libtmux:window-links snapshot)))
                   (window (libtmux:window (aref links 0))))
              (unless (= 1 (length links))
                (refuse-owned-plan planner (vector :windows id) "Changing a shared physical window is unsupported"))
              (when (member (step-action step) '(:split-pane :select-layout))
                (unless (= (length (getf mapped :panes)) (length (libtmux:panes window)))
                  (refuse-owned-plan planner (vector :windows id) "Geometry changes would affect unmanaged panes"))
                (let ((geometry (owned-by-id physical-id (getf (getf data :geometry) :windows) :window-id)))
                  (unless (and geometry (getf geometry :regular-p))
                    (refuse-owned-plan planner (vector :windows id) "Geometry changes require complete unzoomed regular pane facts")))))))))))

(defun owned-planner-data (planner publication)
  (deep-copy
   (list :changes (coerce (reverse (owned-planner-changes planner)) 'simple-vector)
         :drift (coerce (reverse (owned-planner-drift planner)) 'simple-vector)
         :conflicts (coerce (reverse (owned-planner-conflicts planner)) 'simple-vector)
         :context (coerce (reverse (owned-planner-context planner)) 'simple-vector)
         :publish-p publication)))

(defun owned-pane-creation-data (session window pane)
  (append (let ((cwd (or (getf pane :cwd) (getf window :cwd) (getf session :cwd))))
            (when cwd (list :cwd cwd)))
          (when (nth-value 1 (plist-value pane :command)) (list :command (getf pane :command)))
          (when (nth-value 1 (plist-value pane :shell-command))
            (list :shell-command (getf pane :shell-command)))))

(defun emit-owned-pane-additions (planner session window old-panes)
  (let* ((panes (getf window :panes))
         (remaining (count-if (lambda (pane) (not (owned-by-id (getf pane :id) old-panes))) panes))
         (previous nil))
    (loop for pane across panes
          for id = (getf pane :id)
          do (unless (owned-by-id id old-panes)
               (apply #'emit-owned-step planner :split-pane
                      :session-id (getf session :id) :window-id (getf window :id) :pane-id id
                      :anchor-id (or previous (getf (aref old-panes 0) :id))
                      :before (null previous) :direction :adaptive
                      (owned-pane-creation-data session window pane))
               (when (plusp (decf remaining))
                 (emit-owned-step planner :select-layout :session-id (getf session :id)
                                  :window-id (getf window :id) :layout :tiled)))
             (setf previous id))))

(defun emit-owned-new-window (planner session window &key first-p move-index)
  (let ((pane (aref (getf window :panes) 0)))
    (apply #'emit-owned-step planner (if first-p :create-session :create-window)
           :session-id (getf session :id) :window-id (getf window :id) :pane-id (getf pane :id)
           :name (getf window :name)
           (append (when first-p (list :session-name (getf session :name)))
                   (when (and first-p (nth-value 1 (plist-value session :environment)))
                     (list :environment (getf session :environment)))
                   (when (and (not first-p) (nth-value 1 (plist-value window :index)))
                     (list :index (getf window :index)))
                   (owned-pane-creation-data session window pane)))
    (when move-index
      (emit-owned-step planner :move-window :session-id (getf session :id)
                       :window-id (getf window :id) :index move-index))
    (emit-owned-pane-additions planner session window (vector pane))
    (when (getf window :layout)
      (emit-owned-step planner :select-layout :session-id (getf session :id)
                       :window-id (getf window :id) :layout (getf window :layout)))))

(defun plan-owned-vacant (planner)
  (let* ((wanted (slot-value (owned-planner-declaration planner) 'data))
         (session (getf wanted :session)) (windows (getf session :windows))
         (first (aref windows 0)) (rest (subseq windows 1))
         (explicit (remove-if (lambda (window) (not (nth-value 1 (plist-value window :index)))) rest))
         (automatic (remove-if (lambda (window) (nth-value 1 (plist-value window :index))) rest))
         (reserved (map 'list (lambda (window) (getf window :index)) explicit)))
    (when (matching-session (owned-state-snapshot (owned-planner-state planner)) (getf session :name))
      (refuse-owned-plan planner #(:session :name) "A captured unowned session occupies the desired name"))
    (emit-owned-new-window planner session first :first-p t
                           :move-index (cond ((nth-value 1 (plist-value first :index)) (getf first :index))
                                             (reserved (first-free-index reserved))))
    (map nil (lambda (window) (emit-owned-new-window planner session window)) explicit)
    (map nil (lambda (window) (emit-owned-new-window planner session window)) automatic)))

(defun plan-owned-new-windows (planner session previous mapped-session snapshot)
  (let* ((new (remove-if (lambda (window) (owned-by-id (getf window :id) (getf previous :windows)))
                         (getf session :windows)))
         (explicit (remove-if (lambda (window) (not (nth-value 1 (plist-value window :index)))) new))
         (automatic (remove-if (lambda (window) (nth-value 1 (plist-value window :index))) new))
         (observed-session (find (getf mapped-session :physical-id) (libtmux:sessions snapshot)
                                 :key #'libtmux:id :test #'string=)))
    (map nil (lambda (window)
               (when (find (getf window :index) (libtmux:window-links observed-session) :key #'libtmux:index)
                 (refuse-owned-plan planner (vector :windows (getf window :id) :index)
                                    "A captured link occupies the new explicit index"))
               (emit-owned-new-window planner session window)) explicit)
    (map nil (lambda (window) (emit-owned-new-window planner session window)) automatic)))

(defun plan-owned-existing (planner)
  (let* ((state (owned-planner-state planner))
         (snapshot (owned-state-snapshot state))
         (record (getf (slot-value state 'data) :committed))
         (old (getf record :declaration))
         (wanted (slot-value (owned-planner-declaration planner) 'data))
         (session (getf wanted :session)) (old-session (getf old :session))
         (session-id (getf session :id))
         (mapped-session (getf record :session))
         (observed-session (find (getf mapped-session :physical-id) (libtmux:sessions snapshot)
                                 :key #'libtmux:id :test #'string=)))
    (validate-owned-graph (make-owned-record :committed record) snapshot)
    (check-owned-declaration-edits planner old wanted record)
    (note-owned-difference planner :change #(:session :name)
                           (getf old-session :name) (getf session :name))
    (note-owned-difference planner :drift #(:session :name)
                           (getf mapped-session :name) (libtmux:name observed-session))
    (when (find-if (lambda (candidate)
                     (and (string= (getf session :name) (libtmux:name candidate))
                          (not (string= (getf mapped-session :physical-id) (libtmux:id candidate)))))
                   (libtmux:sessions snapshot))
      (refuse-owned-plan planner #(:session :name) "Another captured session occupies the desired name"))
    (unless (string= (getf session :name) (libtmux:name observed-session))
      (emit-owned-step planner :rename-session :session-id session-id :name (getf session :name)))
    (loop for window across (remove-if (lambda (window) (not (owned-by-id (getf window :id) (getf old-session :windows))))
                                      (getf session :windows))
          for id = (getf window :id)
          for previous = (find id (getf old-session :windows)
                               :key (lambda (item) (getf item :id)) :test #'string=)
          for mapped = (find id (getf record :windows)
                             :key (lambda (item) (getf item :logical-id)) :test #'string=)
          for observed = (find (getf mapped :physical-id) (libtmux:windows snapshot)
                               :key #'libtmux:id :test #'string=)
          for path = (vector :windows id)
          do (note-owned-difference planner :change (path+ path :name)
                                    (getf previous :name) (getf window :name))
             (note-owned-difference planner :drift (path+ path :name)
                                    (getf mapped :name) (libtmux:name observed))
             (let ((expected (map 'list (lambda (pane) (getf pane :physical-id)) (getf mapped :panes)))
                   (actual (loop for pane across (libtmux:panes observed)
                                 when (owned-by-id (libtmux:id pane) (getf mapped :panes) :physical-id)
                                   collect (libtmux:id pane))))
               (unless (equal expected actual)
                 (note-owned-difference planner :drift (path+ path :panes) expected actual)
                 (refuse-owned-plan planner (path+ path :panes) "Captured owned pane order changed")))
             (unless (string= (getf window :name) (libtmux:name observed))
               (emit-owned-step planner :rename-window :session-id session-id :window-id id
                                :name (getf window :name)))
             (emit-owned-pane-additions planner session window (getf previous :panes))
             (let ((layout (libtmux:field-value observed :window/layout))
                   (added (> (length (getf window :panes)) (length (getf previous :panes)))))
               (note-owned-difference planner :drift (path+ path :layout) (getf mapped :layout) layout)
               (when (or (and (not added) (not (string= layout (getf mapped :layout))))
                         (and (getf window :layout)
                              (or added (not (owned-value= (getf previous :layout) (getf window :layout)))
                                  (not (string= layout (getf mapped :layout))))))
                 (emit-owned-step planner :select-layout :session-id session-id :window-id id
                                  :layout (or (getf window :layout)
                                              (list :custom (getf mapped :layout)))))))
    (plan-owned-new-windows planner session old-session mapped-session snapshot)))

(defun plan-owned-workspace (declaration state &key reconcile)
  "Prepare a private eager preview from explicit owned observations, without I/O."
  (check-type declaration owned-declaration)
  (check-type state owned-state)
  (let* ((planner (make-owned-planner :declaration declaration :state state))
         (state-data (slot-value state 'data)) (status (getf state-data :status)))
    (unless (string= (getf (slot-value declaration 'data) :id) (getf (getf state-data :declaration) :id))
      (refuse-owned-plan planner #(:id) "Desired workspace ID differs from the acquired namespace"))
    (case status
      (:owned (plan-owned-existing planner))
      (:vacant (plan-owned-vacant planner))
      (otherwise (refuse-owned-plan planner #() "Owned planning requires a ready acquired state")))
    (collect-owned-plan-context planner)
    (let* ((steps (coerce (reverse (owned-planner-steps planner)) 'simple-vector))
           (publication (not (null (or (owned-planner-changes planner) (plusp (length steps))))))
           (data nil))
      (when (eq :owned status) (check-owned-effect-scopes planner publication))
      (setf data (owned-planner-data planner publication))
      (when (or (owned-planner-conflicts planner)
                (and (not reconcile) (or (owned-planner-changes planner) (owned-planner-drift planner))))
        (error 'owned-plan-conflict
               :message (if (owned-planner-conflicts planner)
                            "Owned workspace plan has unsupported changes; inspect its conflict data"
                            "Owned declaration or captured state changed; reconcile explicitly")
               :data data))
      (make-instance 'owned-plan :declaration declaration :state state :steps steps :data data))))
