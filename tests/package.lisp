(defpackage #:libtmux.tests
  (:use #:cl #:fiveam)
  (:export #:run-suite))

(in-package #:libtmux.tests)

(def-suite unit)
(def-suite query)
(def-suite regex)
(def-suite json)
(def-suite control)
(def-suite workspace)
(def-suite integration)
(def-suite transport-integration)
(def-suite workspace-integration)
(def-suite control-integration)
(def-suite configuration-integration)

(defun run-suite (name)
  (run! (ecase name
          (:unit 'unit)
          (:query 'query)
          (:regex 'regex)
          (:json 'json)
          (:control 'control)
          (:transport-integration 'transport-integration)
          (:workspace-integration 'workspace-integration)
          (:control-integration 'control-integration)
          (:configuration-integration 'configuration-integration)
          (:workspace 'workspace)
          (:integration 'integration))))
