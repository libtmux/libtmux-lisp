(in-package #:libtmux.tests)

(in-suite workspace-public-integration)

(defun public-workspace-call (name &rest arguments)
  (apply (public-workspace-function name) arguments))

(defun call-public-workspace-cli (fixture file command &rest options)
  (let* ((stdout (make-string-output-stream)) (stderr (make-string-output-stream))
         (code (libtmux.workspace.cli:main
                :arguments (append (list command (namestring file) "--socket-path" (fixture-socket fixture)
                                         "--program" (or (uiop:getenv "LIBTMUX_TEST_TMUX") "tmux")) options)
                :stdout stdout :stderr stderr))
         (out (get-output-stream-string stdout)) (err (get-output-stream-string stderr)))
    (values code (com.inuoe.jzon:parse (if (zerop code) out err)) out err)))

(test public-owned-cli-reports-preview-publication-noop-and-busy-inspection
  (with-tmux-fixture (fixture)
    (let ((file (merge-pathnames "public.json" (fixture-directory fixture))))
      (with-open-file (stream file :direction :output :if-exists :error :external-format :utf-8)
        (write-string "{\"schema\":\"libtmux.lisp.workspace/2\",\"id\":\"public-cli\",\"session\":{\"id\":\"main\",\"name\":\"public-cli\",\"windows\":[{\"id\":\"shell\",\"name\":\"shell\",\"panes\":[{\"id\":\"shell\",\"command\":[\"/bin/cat\"]}]}]}}" stream))
      (multiple-value-bind (code document out err) (call-public-workspace-cli fixture file "plan")
        (declare (ignore out))
        (is (= 0 code)) (is (string= "" err))
        (is (gethash "publish-p" (gethash "data" document))))
      (let (head original)
        (multiple-value-bind (code document) (call-public-workspace-cli fixture file "apply")
          (is (= 0 code))
          (let ((data (gethash "data" document)))
            (is (string= "published" (gethash "status" data)))
            (is (string= "succeeded" (gethash "publication-status" data)))
            (setf original (gethash "record" data) head (gethash "revision" original))))
        (multiple-value-bind (code document) (call-public-workspace-cli fixture file "apply")
          (is (= 0 code))
          (let ((data (gethash "data" document)))
            (is (string= "unchanged" (gethash "status" data)))
            (is (eq 'null (gethash "publication-status" data)))
            (is (string= head (gethash "revision" (gethash "record" data))))))
        (with-open-file (stream file :direction :output :if-exists :supersede :external-format :utf-8)
          (write-string "{\"schema\":\"libtmux.lisp.workspace/2\",\"id\":\"public-cli\",\"session\":{\"id\":\"main\",\"name\":\"cli-renamed\",\"windows\":[{\"id\":\"shell\",\"name\":\"editors\",\"layout\":\"even-horizontal\",\"panes\":[{\"id\":\"shell\",\"command\":[\"/bin/cat\"]},{\"id\":\"extra\",\"command\":[\"/bin/cat\"]}]}]}}" stream))
        (multiple-value-bind (code document) (call-public-workspace-cli fixture file "plan")
          (is (= 1 code))
          (is (string= "workspace-conflict" (gethash "condition" document)))
          (is (plusp (length (gethash "changes" (gethash "plan" document))))))
        (multiple-value-bind (code document) (call-public-workspace-cli fixture file "plan" "--reconcile")
          (is (= 0 code)) (is (gethash "publish-p" (gethash "data" document))))
        (multiple-value-bind (code document) (call-public-workspace-cli fixture file "apply" "--reconcile")
          (is (= 0 code))
          (let* ((record (gethash "record" (gethash "data" document)))
                 (window (aref (gethash "windows" record) 0))
                 (old-window (aref (gethash "windows" original) 0)))
            (is (string= "cli-renamed" (gethash "name" (gethash "session" record))))
            (is (string= (gethash "physical-id" (gethash "session" original))
                         (gethash "physical-id" (gethash "session" record))))
            (is (string= (gethash "physical-id" old-window) (gethash "physical-id" window)))
            (is (string= (gethash "physical-id" (aref (gethash "panes" old-window) 0))
                         (gethash "physical-id" (aref (gethash "panes" window) 0))))
            (is (= 2 (length (gethash "panes" window))))
            (setf head (gethash "revision" record))))
        (with-open-file (stream file :direction :output :if-exists :supersede :external-format :utf-8)
          (write-string "{\"schema\":\"libtmux.lisp.workspace/2\",\"id\":\"public-cli\",\"session\":{\"id\":\"main\",\"name\":\"cli-renamed\",\"windows\":[{\"id\":\"shell\",\"name\":\"editors\",\"layout\":{\"custom\":\"0000,80x24,0,0,0\"},\"panes\":[{\"id\":\"shell\",\"command\":[\"/bin/cat\"]},{\"id\":\"extra\",\"command\":[\"/bin/cat\"]}]}]}}" stream))
        (let (control)
          (multiple-value-bind (code document out) (call-public-workspace-cli fixture file "apply" "--reconcile")
            (is (= 1 code)) (is (string= "" out))
            (is (string= "select-layout" (gethash "action" (gethash "failedStep" document))))
            (let ((data (gethash "data" document)))
              (is (eq 'null (gethash "publication-status" data)))
              (is (string= head (gethash "revision" (gethash "record" data))))
              (setf control (gethash "control" (gethash "writer" data))))
            (is (plusp (length (gethash "outcomes" document))))
            (is (plusp (length (gethash "causes" document)))))
          (multiple-value-bind (code document) (call-public-workspace-cli fixture file "inspect")
            (let* ((terminal (gethash "terminal" document)) (outcome (and terminal (gethash "outcome" terminal))))
              (is (= 0 code) "INSPECT failed: ~A; terminal stderr: ~A"
                  (gethash "message" document)
                  (and outcome (map 'string #'code-char (gethash "stderrBytes" outcome)))))
            (is (string= "inspected" (gethash "status" document)))
            (is (gethash "complete-p" (gethash "data" document)))
            (is (not (equalp #() (gethash "outcomes" document)))))
          (multiple-value-bind (code document out) (call-public-workspace-cli fixture file "plan")
            (is (= 1 code)) (is (string= "" out))
            (is (string= "workspace-state-error" (gethash "condition" document)))
            (is (equal control (gethash "control" (gethash "state" document))))))
        (let ((open (symbol-function 'libtmux:open-client)))
          (unwind-protect
               (progn
                 (setf (symbol-function 'libtmux:open-client)
                       (lambda (&rest options) (apply open :output-limit 16 options)))
                 (multiple-value-bind (code document out) (call-public-workspace-cli fixture file "inspect")
                   (is (= 1 code)) (is (string= "" out))
                   (is (string= "workspace-inspection-error" (gethash "condition" document)))
                   (is (null (gethash "complete-p" (gethash "data" (gethash "inspection" document)))))
                   (is (hash-table-p (gethash "terminal" document)))))
            (setf (symbol-function 'libtmux:open-client) open)))))))

(test public-owned-reconcile-previews-and-applies-with-stable-identities
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let* ((workspace (libtmux.workspace:make-workspace
                         (state-call :owned-declaration-data (state-fixture-declaration "public-reconcile" "public"))))
             (before (libtmux.workspace:apply-workspace client workspace))
             (old (getf (public-workspace-call :result-data before) :record))
             (wanted (libtmux.workspace:workspace-data workspace))
             (session (getf wanted :session)) (window (aref (getf session :windows) 0)))
        (setf (getf session :name) "public-renamed"
              (getf window :name) "editor-renamed"
              (getf window :layout) :even-horizontal
              (getf window :panes) (concatenate 'vector (getf window :panes)
                                               #((:id "extra" :command #("/bin/cat")))))
        (let* ((next (libtmux.workspace:make-workspace wanted))
               (state (public-workspace-call :fetch-workspace-state client next))
               (refusal (handler-case (libtmux.workspace:plan-workspace next state)
                          (libtmux.workspace:workspace-conflict (condition) condition)))
               (plan (libtmux.workspace:plan-workspace next state :reconcile t)))
          (is (typep refusal 'libtmux.workspace:workspace-conflict))
          (is-true (nth-value 1 (public-workspace-call :plan-data refusal)))
          (is-true (getf (public-workspace-call :plan-data plan) :publish-p))
          (let* ((after (libtmux.workspace:apply-workspace client next :reconcile t))
                 (record (getf (public-workspace-call :result-data after) :record))
                 (old-window (aref (getf old :windows) 0)) (new-window (aref (getf record :windows) 0)))
            (is (not (libtmux.workspace:result-created-p after)))
            (is (equal (getf (getf old :session) :physical-id) (getf (getf record :session) :physical-id)))
            (is (equal (getf old-window :physical-id) (getf new-window :physical-id)))
            (is (equal (getf (aref (getf old-window :panes) 0) :physical-id)
                       (getf (aref (getf new-window :panes) 0) :physical-id)))
            (is (= 2 (length (getf new-window :panes))))
            (is (string= "public-renamed" (getf (getf record :session) :name)))))))))

(test public-owned-state-and-incomplete-inspection-retain-read-failures
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let* ((workspace (libtmux.workspace:make-workspace
                         (state-call :owned-declaration-data (state-fixture-declaration "public-inspection" "public"))))
             (before (libtmux.workspace:apply-workspace client workspace))
             (head (getf (getf (public-workspace-call :result-data before) :record) :revision))
             (control (state-call :make-owned-control :busy head (writer-token #\C))))
        (fixture-ok fixture "set-option" "-s" "--" (concatenate 'string (state-call :owned-namespace "public") "control") control)
        (let* ((failure (handler-case (public-workspace-call :fetch-workspace-state client workspace)
                          (libtmux.workspace:workspace-state-error (condition) condition)))
               (inspection (public-workspace-call :inspect-workspace client workspace)))
          (is (typep failure 'libtmux.workspace:workspace-state-error))
          (is (plusp (length (public-workspace-call :state-causes failure))))
          (is (plusp (length (public-workspace-call :state-outcomes failure))))
          (is (equal control (getf (public-workspace-call :state-data failure) :control)))
          (is (getf (public-workspace-call :inspection-data inspection) :complete-p))
          (is (plusp (length (public-workspace-call :inspection-outcomes inspection))))
          (signals libtmux.workspace:workspace-conflict (libtmux.workspace:plan-workspace workspace inspection))
          (let* ((stopped (handler-case (public-workspace-call :inspect-workspace client workspace :output-limit 1)
                            (libtmux.workspace:workspace-inspection-error (condition) condition)))
                 (partial (public-workspace-call :inspection-evidence stopped)))
            (is (not (getf (public-workspace-call :inspection-data partial) :complete-p)))
            (is (typep (public-workspace-call :inspection-terminal stopped) 'condition))
            (is (plusp (length (public-workspace-call :inspection-causes partial))))))))))

(test public-owned-workspace-acquires-previews-applies-and-retains-local-evidence
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let* ((declaration (state-call :owned-declaration-data (state-fixture-declaration "public-owned" "public")))
             (workspace (libtmux.workspace:make-workspace declaration))
             (state (public-workspace-call :fetch-workspace-state client workspace))
             (plan (libtmux.workspace:plan-workspace workspace state)))
        (is (eq :vacant (getf (public-workspace-call :state-data state) :status)))
        (is-true (getf (public-workspace-call :plan-data plan) :publish-p))
        (is (plusp (length (libtmux.workspace:plan-steps plan))))
        (let* ((result (libtmux.workspace:apply-workspace client workspace))
               (data (public-workspace-call :result-data result))
               (record (getf data :record)))
          (is (libtmux.workspace:result-created-p result))
          (is (eq :published (getf data :status)))
          (is (eq :succeeded (getf data :publication-status)))
          (is (plusp (length (libtmux.workspace:result-outcomes result))))
          (let ((mutations 0))
            (let* ((libtmux.internal::*process-launched-hook*
                     (lambda (job) (when (workspace-mutation-job-p job) (incf mutations))))
                   (again (libtmux.workspace:apply-workspace client workspace)))
              (is (eq :unchanged (getf (public-workspace-call :result-data again) :status)))
              (is (not (libtmux.workspace:result-created-p again)))
              (is (= 0 mutations))))
          (let ((ready (public-workspace-call :fetch-workspace-state client workspace)))
            (libtmux:close-client client)
            (let ((libtmux.internal::*process-launched-hook*
                    (lambda (job) (declare (ignore job)) (error "Local public inspection contacted tmux"))))
              (is (not (getf (public-workspace-call :plan-data (libtmux.workspace:plan-workspace workspace ready)) :publish-p)))
              (setf (char (getf (getf record :session) :physical-id) 0) #\X)
              (is (char= #\$ (char (getf (getf (getf (public-workspace-call :result-data result) :record) :session) :physical-id) 0))))))))))

(test public-owned-application-failure-retains-step-snapshot-data-and-causes
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let* ((workspace (libtmux.workspace:make-workspace
                         (state-call :owned-declaration-data (state-fixture-declaration "public-failure" "public"))))
             (before (libtmux.workspace:apply-workspace client workspace))
             (head (getf (getf (public-workspace-call :result-data before) :record) :revision))
             (wanted (libtmux.workspace:workspace-data workspace))
             (changed nil) (failure nil))
        (setf (getf (aref (getf (getf wanted :session) :windows) 0) :name) "must-not-rename")
        (let ((libtmux.internal::*dispatch-context-check*
                (lambda (actual witness current)
                  (declare (ignore actual witness))
                  (when (and (not changed) (some (lambda (target) (typep target 'libtmux:window)) current))
                    (setf changed t)
                    (let* ((key (concatenate 'string (state-call :owned-namespace "public") "control"))
                           (control (state-call :parse-owned-control
                                                (string-right-trim '(#\Newline) (fixture-ok fixture "show-options" "-s" "-v" key))))
                           (token (writer-token (if (string= (getf control :writer) (writer-token #\C)) #\D #\C))))
                      (fixture-ok fixture "set-option" "-s" "--" key (state-call :make-owned-control :busy head token)))))))
          (declare (special libtmux.internal::*dispatch-context-check*))
          (handler-case (libtmux.workspace:apply-workspace client (libtmux.workspace:make-workspace wanted) :reconcile t)
            (libtmux.workspace:workspace-apply-failed (condition) (setf failure condition))))
        (is-true changed)
        (is-true failure)
        (when failure
          (let ((data (public-workspace-call :result-data failure))
                (step (libtmux.workspace:failed-step failure)))
            (is (eq :execute (getf data :phase)))
            (is (eq :rename-window (libtmux.workspace:step-action step)))
            (is (typep (libtmux.workspace:result-snapshot failure) 'libtmux:snapshot))
            (is (plusp (length (public-workspace-call :result-causes failure))))
            (is (plusp (length (libtmux.workspace:result-outcomes failure))))
            (is (equal head (getf (getf data :record) :revision)))
            (is (null (getf data :publication-status)))
            (is (not (search "must-not-rename" (fixture-ok fixture "list-windows" "-a" "-F" "#{window_name}"))))))))))
