(in-package #:libtmux.tests)

(in-suite integration)

(test links-retain-context-through-move-and-swap
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let* ((session (aref (libtmux:fetch-sessions client) 0))
             (original (aref (libtmux:window-links session) 0))
             (window (libtmux:window original))
             (other (libtmux:outcome-value (libtmux:new-window client session :index 3 :command '("/bin/cat"))))
             (duplicate (libtmux:outcome-value (libtmux:link-window client original session 7)))
             (snapshot (libtmux:fetch-snapshot client))
             (destination (libtmux:outcome-value (libtmux:new-session client :command '("/bin/cat"))))
             (moved (libtmux:outcome-value (libtmux:move-window client duplicate destination 5))))
        (is (= 2 (length (libtmux:windows snapshot))))
        (is (= 2 (length (libtmux:panes snapshot))))
        (is (= 3 (length (libtmux:window-links snapshot))))
        (is (libtmux:same-entity-p window (libtmux:window moved)))
        (is (libtmux:same-entity-p destination (libtmux:session moved)))
        (is (= 5 (libtmux:index moved)))
        (is (= 7 (libtmux:index duplicate)))
        (let* ((outcome (libtmux:swap-windows client original (aref (libtmux:window-links other) 0)))
               (replacements (libtmux:outcome-value outcome)))
          (is (libtmux:same-entity-p other (libtmux:window (aref replacements 0))))
          (is (libtmux:same-entity-p window (libtmux:window (aref replacements 1))))
          (setf (aref replacements 0) nil)
          (is (typep (aref (libtmux:outcome-value outcome) 0) 'libtmux:window-link))
          (signals libtmux:stale-target (libtmux:select-window client original :observe nil)))
        (libtmux:unlink-window client moved)
        (is (= 1 (length (libtmux:window-links (libtmux:refresh client window)))))))))

(test pane-placement-retains-physical-identity-and-explicit-break-context
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let* ((session (aref (libtmux:fetch-sessions client) 0))
             (link (aref (libtmux:window-links session) 0))
             (window (libtmux:window link))
             (first (aref (libtmux:panes window) 0))
             (second (libtmux:outcome-value
                      (libtmux:split-pane client first :direction :horizontal :command '("/bin/cat"))))
             (other (libtmux:outcome-value (libtmux:new-window client session :command '("/bin/cat"))))
             (third (aref (libtmux:panes other) 0))
             (swapped (libtmux:outcome-value (libtmux:swap-panes client second third)))
             (moved (libtmux:outcome-value (libtmux:move-pane client second first :direction :horizontal))))
        (is (libtmux:same-entity-p other (libtmux:window (aref swapped 0))))
        (is (libtmux:same-entity-p window (libtmux:window (aref swapped 1))))
        (is (libtmux:same-entity-p second moved))
        (is (libtmux:same-entity-p window (libtmux:window moved)))
        (is (libtmux:same-entity-p other (libtmux:window (aref swapped 0))))
        (signals libtmux:stale-target (libtmux:refresh client other))
        (let* ((before (map 'list #'libtmux:id (libtmux:panes (libtmux:window moved))))
               (rotated (libtmux:outcome-value (libtmux:rotate-window client window))))
          (is (equal (append (rest before) (list (first before)))
                     (map 'list #'libtmux:id (libtmux:panes rotated)))))
        (let* ((destination (libtmux:outcome-value (libtmux:new-window client session :command '("/bin/cat"))))
               (joined (libtmux:outcome-value
                        (libtmux:join-pane client third (aref (libtmux:panes destination) 0)))))
          (is (libtmux:same-entity-p third joined))
          (is (libtmux:same-entity-p destination (libtmux:window joined))))
        (let* ((broken (libtmux:outcome-value
                        (libtmux:break-pane client moved link session 8 :name "broken-#{pid};")))
               (broken-pane (aref (libtmux:panes (libtmux:window broken)) 0))
               (duplicate (libtmux:outcome-value (libtmux:link-window client broken session 10)))
               (relocated (libtmux:outcome-value (libtmux:break-pane client broken-pane broken session 9))))
          (is (libtmux:same-entity-p second broken-pane))
          (is (string= "broken-#{pid};" (libtmux:name (libtmux:window broken))))
          (is (libtmux:same-entity-p (libtmux:window broken) (libtmux:window relocated)))
          (is (libtmux:same-entity-p duplicate (libtmux:refresh client duplicate)))
          (is (equal '(9 10) (sort (map 'list #'libtmux:index
                                      (libtmux:window-links (libtmux:window relocated))) #'<)))
          (signals libtmux:stale-target (libtmux:refresh client broken)))))))
