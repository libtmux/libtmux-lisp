(in-package #:libtmux.tests)

(in-suite workspace-apply-integration)

(defun apply-fixture-declaration (&optional fixture)
  (let* ((declaration (state-call :make-owned-declaration
              '(:schema "libtmux.lisp.workspace/2" :id "application"
                :session (:id "main" :name "native-owned" :cwd "/tmp"
                          :environment #(("OWNED_VALUE" . "λ"))
                          :windows #((:id "editor" :name "same" :index 2 :layout :tiled
                                      :panes #((:id "first" :command #("/bin/cat"))
                                               (:id "second" :shell-command "exec cat")))
                                     (:id "logs" :name "same" :index 0
                                      :panes #((:id "logs" :command #("/bin/cat"))))
                                     (:id "extra" :name "automatic"
                                      :panes #((:id "extra" :command #("/bin/cat")))))))))
         (data (state-call :owned-declaration-data declaration))
         (session (getf data :session)))
    (when fixture
      (setf (getf session :environment)
            (concatenate 'vector (getf session :environment)
                         (vector (cons "OWNED_PROGRAM" (or (uiop:getenv "LIBTMUX_TEST_TMUX") "tmux"))
                                 (cons "OWNED_SOCKET" (fixture-socket fixture))))
            (getf (aref (getf (aref (getf session :windows) 0) :panes) 1) :shell-command)
            "printf 'OWNED-SHELL-PROBE\\n'; \"$OWNED_PROGRAM\" -N -S \"$OWNED_SOCKET\" wait-for -S owned-shell-ready; exec cat"))
    (state-call :make-owned-declaration data)))

(defun apply-record-window (result id)
  (find id (getf (getf (state-call :owned-result-data result) :record) :windows)
        :key (lambda (window) (getf window :logical-id)) :test #'string=))

(defun apply-native-window (result id)
  (let ((mapped (apply-record-window result id)))
    (find (getf mapped :physical-id) (libtmux:windows (state-call :owned-result-snapshot result))
          :key #'libtmux:id :test #'string=)))

(defun apply-failure (function)
  (handler-case (progn (funcall function) (error "Invalid owned application was accepted"))
    (libtmux.workspace::owned-apply-error (condition) condition)))

(defun workspace-mutation-job-p (job &optional domain-only)
  (some (lambda (argument)
          (some (lambda (command) (search command argument))
                (if domain-only
                    '("new-session" "new-window" "split-window" "select-layout" "rename-" "move-window")
                    '("set-option" "new-session" "new-window" "split-window" "select-layout" "rename-" "move-window"))))
        (libtmux.internal::process-job-argv job)))

(test owned-apply-creates-publishes-and-reapplies-by-physical-identity
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let* ((declaration (apply-fixture-declaration fixture))
             (initial (libtmux:fetch-snapshot client))
             (result (state-call :apply-owned-workspace client declaration))
             (data (state-call :owned-result-data result))
             (record (getf data :record))
             (session-id (getf (getf record :session) :physical-id)))
        (is (eq :published (getf data :status)))
        (is (eq :succeeded (getf data :publication-status)))
        (is (= 3 (length (getf record :windows))))
        (is (= 4 (loop for window across (libtmux:windows
                                         (find session-id (libtmux:sessions (state-call :owned-result-snapshot result))
                                               :key #'libtmux:id :test #'string=))
                       sum (length (libtmux:panes window)))))
        (is (= 2 (getf (apply-record-window result "editor") :index)))
        (is (= 0 (getf (apply-record-window result "logs") :index)))
        (is (= 1 (getf (apply-record-window result "extra") :index)))
        (is (not (string= (libtmux:id (apply-native-window result "editor"))
                          (libtmux:id (apply-native-window result "logs")))))
        (is (string= (format nil "OWNED_VALUE=λ~%") (fixture-ok fixture "show-environment" "-t" session-id "OWNED_VALUE")))
        (libtmux:run-command client '("wait-for" "owned-shell-ready") :effect :read :timeout 0.5)
        (let ((shell-pane (find (getf (aref (getf (apply-record-window result "editor") :panes) 1) :physical-id)
                                (libtmux:panes (apply-native-window result "editor")) :key #'libtmux:id :test #'equal)))
          (is (search "OWNED-SHELL-PROBE" (libtmux:capture-pane client shell-pane))))
        (is (string= (libtmux:field-value (aref (libtmux:windows initial) 0) :window/layout)
                     (libtmux:field-value
                      (find "@0" (libtmux:windows (state-call :owned-result-snapshot result)) :key #'libtmux:id :test #'string=)
                      :window/layout)))
        (let ((mutations 0))
          (let* ((libtmux.internal::*process-launched-hook*
                   (lambda (job) (when (workspace-mutation-job-p job) (incf mutations))))
                 (again (state-call :apply-owned-workspace client declaration)))
            (is (eq :unchanged (getf (state-call :owned-result-data again) :status)))
            (is (equal session-id (getf (getf (state-call :owned-result-data again) :mappings) :session-id)))
            (is (= 3 (length (getf (getf (state-call :owned-result-data again) :mappings) :windows))))
            (is (= 0 mutations))))
        (let ((libtmux.internal::*process-launched-hook*
                (lambda (job) (declare (ignore job)) (error "Result inspection contacted tmux"))))
          (setf (char (getf (getf record :session) :physical-id) 0) #\X)
          (is (char= #\$ (char (getf (getf (getf (state-call :owned-result-data result) :record) :session) :physical-id) 0))))))))

(test owned-apply-reconciles-names-and-insertions-without-changing-old-identities
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let* ((declaration (apply-fixture-declaration))
             (before (state-call :apply-owned-workspace client declaration))
             (wanted (state-call :owned-declaration-data declaration))
             (session (getf wanted :session))
             (editor (aref (getf session :windows) 0))
             (panes (getf editor :panes))
             (old (apply-record-window before "editor")))
        (setf (getf session :name) "native-renamed"
              (getf editor :name) "editor-renamed"
              (getf editor :panes)
              (vector '(:id "leading" :command #("/bin/cat")) (aref panes 0)
                      '(:id "middle" :command #("/bin/cat")) (aref panes 1)
                      '(:id "trailing" :command #("/bin/cat"))))
        (let ((next (state-call :make-owned-declaration wanted)))
          (let ((failure (apply-failure (lambda () (state-call :apply-owned-workspace client next)))))
            (is (equal (getf (getf (getf (state-call :owned-result-data before) :record) :session) :physical-id)
                       (getf (getf (state-call :owned-apply-error-data failure) :mappings) :session-id))))
          (let* ((after (state-call :apply-owned-workspace client next :reconcile t))
                 (mapped (apply-record-window after "editor"))
                 (window (apply-native-window after "editor")))
            (is (string= (getf old :physical-id) (getf mapped :physical-id)))
            (loop for pane across (getf old :panes)
                  for found = (find (getf pane :logical-id) (getf mapped :panes)
                                    :key (lambda (item) (getf item :logical-id)) :test #'string=)
                  do (is (string= (getf pane :physical-id) (getf found :physical-id))))
            (is (equal (map 'list (lambda (pane) (getf pane :physical-id)) (getf mapped :panes))
                       (map 'list #'libtmux:id (libtmux:panes window))))
            (is (string= "editor-renamed" (libtmux:name window)))
            (is (string= "same" (libtmux:name (apply-native-window after "logs"))))))))))

(test owned-apply-supports-realized-index-metadata-and-custom-layout-revisions
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let* ((declaration (state-fixture-declaration "native-single" "single"))
             (first (state-call :apply-owned-workspace client declaration))
             (first-record (getf (state-call :owned-result-data first) :record))
             (wanted (state-call :owned-declaration-data declaration))
             (windows (getf (getf wanted :session) :windows)))
        (is (= 0 (getf (apply-record-window first "shell") :index)))
        (remf (aref windows 0) :index)
        (let* ((domain-commands 0)
               (libtmux.internal::*process-launched-hook*
                 (lambda (job) (when (workspace-mutation-job-p job t) (incf domain-commands))))
               (second (state-call :apply-owned-workspace client (state-call :make-owned-declaration wanted) :reconcile t))
               (record (getf (state-call :owned-result-data second) :record)))
          (is (= 0 domain-commands))
          (is (equal (getf first-record :revision) (getf (getf record :previous) :revision)))
          (is (= 0 (getf (apply-record-window second "shell") :index)))
          (setf (getf (aref windows 0) :layout) (list :custom (getf (apply-record-window second "shell") :layout)))
          (let* ((third (state-call :apply-owned-workspace client (state-call :make-owned-declaration wanted) :reconcile t))
                 (third-record (getf (state-call :owned-result-data third) :record)))
            (is (equal (getf record :revision) (getf (getf third-record :previous) :revision)))
            (is (string= (getf (apply-record-window second "shell") :physical-id)
                         (getf (apply-record-window third "shell") :physical-id)))
            (is (not (search (state-call :owned-record-key "single" :committed (getf first-record :revision))
                             (fixture-ok fixture "show-options" "-s"))))))))))

(test owned-apply-repairs-layout-drift-and-removes-a-layout-constraint
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let* ((wanted (state-call :owned-declaration-data (state-fixture-declaration "layout-owned" "layout")))
             (windows (getf (getf wanted :session) :windows)))
        (setf (getf (aref windows 0) :layout) :even-horizontal
              (getf (aref windows 0) :panes) #((:id "one" :command #("/bin/cat")) (:id "two" :command #("/bin/cat"))))
        (let* ((declaration (state-call :make-owned-declaration wanted))
               (before (state-call :apply-owned-workspace client declaration))
               (mapped (apply-record-window before "shell")))
          (fixture-ok fixture "select-layout" "-t" (getf mapped :physical-id) "even-vertical")
          (apply-failure (lambda () (state-call :apply-owned-workspace client declaration)))
          (let* ((repaired (state-call :apply-owned-workspace client declaration :reconcile t))
                 (actual (apply-record-window repaired "shell")))
            (is (equal (getf mapped :physical-id) (getf actual :physical-id)))
            (is (string= (getf mapped :layout) (getf actual :layout)))
            (remf (aref windows 0) :layout)
            (let* ((domain-commands 0)
                   (libtmux.internal::*process-launched-hook*
                     (lambda (job) (when (workspace-mutation-job-p job t) (incf domain-commands))))
                   (without (state-call :apply-owned-workspace client (state-call :make-owned-declaration wanted) :reconcile t))
                   (record (getf (state-call :owned-result-data without) :record)))
              (is (= 0 domain-commands))
              (is (null (getf (aref (getf (getf (getf record :declaration) :session) :windows) 0) :layout)))
              (is (equal (getf actual :physical-id) (getf (apply-record-window without "shell") :physical-id))))))))))

(test owned-apply-checks-the-total-deadline-after-local-no-op-planning
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let* ((declaration (install-state-fixture fixture client))
             (plan (symbol-function 'libtmux.workspace::plan-owned-workspace))
             (clock (symbol-function 'libtmux.internal::monotonic-seconds))
             (mutations 0) (failure nil))
        (unwind-protect
             (progn
               (setf (symbol-function 'libtmux.workspace::plan-owned-workspace)
                     (lambda (&rest arguments)
                       (prog1 (apply plan arguments)
                         (let ((expired (+ 1000 (funcall clock))))
                           (setf (symbol-function 'libtmux.internal::monotonic-seconds) (lambda () expired))))))
               (let ((libtmux.internal::*process-launched-hook*
                       (lambda (job) (when (workspace-mutation-job-p job) (incf mutations)))))
                 (setf failure (apply-failure (lambda () (state-call :apply-owned-workspace client declaration
                                                                    :total-timeout 10))))))
          (setf (symbol-function 'libtmux.workspace::plan-owned-workspace) plan
                (symbol-function 'libtmux.internal::monotonic-seconds) clock))
        (let ((data (state-call :owned-apply-error-data failure)))
          (is (eq :plan (getf data :phase)))
          (is (typep (libtmux:error-cause failure) 'libtmux.workspace:workspace-deadline-exceeded))
          (is (null (getf data :writer)))
          (is (= 0 mutations)))))))

(test owned-apply-adds-a-window-without-adopting-unmanaged-panes
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (fixture-ok fixture "split-window" "-d" "-t" "%0" "--" "/bin/cat")
      (let* ((declaration (install-state-fixture fixture client))
             (wanted (state-call :owned-declaration-data declaration))
             (session (getf wanted :session)) (windows (getf session :windows))
             (initial-layout (fixture-ok fixture "display-message" "-p" "-t" "@0" "#{window_layout}")))
        (setf (getf (aref windows 0) :name) "renamed-with-unmanaged"
              (getf session :windows)
              (concatenate 'vector windows #((:id "added" :name "added" :index 3
                                              :panes #((:id "first" :command #("/bin/cat"))
                                                       (:id "second" :command #("/bin/cat")))))))
        (let* ((result (state-call :apply-owned-workspace client (state-call :make-owned-declaration wanted) :reconcile t))
               (record (getf (state-call :owned-result-data result) :record))
               (old (apply-record-window result "shell")) (added (apply-record-window result "added")))
          (is (= 2 (length (getf record :windows))))
          (is (string= "@0" (getf old :physical-id)))
          (is (= 1 (length (getf old :panes))))
          (is (string= "%0" (getf (aref (getf old :panes) 0) :physical-id)))
          (is (string= initial-layout (fixture-ok fixture "display-message" "-p" "-t" "@0" "#{window_layout}")))
          (is (equal '("%0" "%1") (map 'list #'libtmux:id (libtmux:panes (apply-native-window result "shell")))))
          (is (= 3 (getf added :index)))
          (is (= 2 (length (getf added :panes)))))))))

(test owned-apply-rejects-zoom-and-pane-reorder-after-domain-preflight
  (dolist (scenario '(:zoom :reorder))
   (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (fixture-ok fixture "set-window-option" "-g" "pane-base-index" "7")
      (let* ((input (state-call :owned-declaration-data (state-fixture-declaration "zoom-owned" "zoom")))
             (window (aref (getf (getf input :session) :windows) 0))
             (execute (symbol-function 'libtmux.workspace::execute-owned-step))
             (changed nil) (failure nil))
        (setf (getf window :panes) #((:id "one" :command #("/bin/cat")) (:id "two" :command #("/bin/cat"))))
        (let* ((before (state-call :apply-owned-workspace client (state-call :make-owned-declaration input)))
               (native (apply-native-window before "shell")) (target (libtmux:id (aref (libtmux:panes native) 0))))
          (setf (getf window :panes) (concatenate 'vector (getf window :panes) #((:id "three" :command #("/bin/cat")))))
          (unwind-protect
               (progn
                 (setf (symbol-function 'libtmux.workspace::execute-owned-step)
                       (lambda (application step)
                         (let ((libtmux.internal::*dispatch-context-check*
                                 (lambda (actual witness current)
                                   (declare (ignore actual witness current))
                                   (unless changed
                                     (setf changed t)
                                     (if (eq scenario :zoom)
                                         (fixture-ok fixture "resize-pane" "-Z" "-t" target)
                                         (fixture-ok fixture "swap-pane" "-s" target "-t"
                                                     (libtmux:id (aref (libtmux:panes native) 1))))))))
                           (declare (special libtmux.internal::*dispatch-context-check*))
                           (funcall execute application step))))
                 (setf failure (apply-failure (lambda () (state-call :apply-owned-workspace client
                                                                    (state-call :make-owned-declaration input) :reconcile t)))))
            (setf (symbol-function 'libtmux.workspace::execute-owned-step) execute))
          (is-true changed)
          (is (eq :execute (getf (state-call :owned-apply-error-data failure) :phase)))
          (is (null (getf (state-call :owned-apply-error-data failure) :publication-status)))
          (is (string= (format nil "2~%") (fixture-ok fixture "display-message" "-p" "-t" target "#{window_panes}")))))))))
