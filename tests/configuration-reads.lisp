(in-package #:libtmux.tests)
(in-suite configuration-integration)

(test decoded-configuration-preserves-values-ownership-and-inheritance
  (with-tmux-fixture (fixture)
    (libtmux:with-client (client :program (or (uiop:getenv "LIBTMUX_TEST_TMUX") "tmux")
                                 :socket-path (fixture-socket fixture))
      (let* ((snapshot (libtmux:fetch-snapshot client)) (session (aref (libtmux:sessions snapshot) 0))
             (pane (aref (libtmux:panes snapshot) 0))
             (window (libtmux:window pane))
             (value (format nil "line~%%end 0 0 0~%\"\\ ${VALUE} 雪"))
             (control-launched nil)
             (libtmux.internal::*process-launched-hook*
               (lambda (job)
                 (when (find "-C" (libtmux.internal::process-job-argv job) :test #'string=)
                   (setf control-launched t)))))
        (libtmux:set-option client "renumber-windows" nil :scope :session :target session)
        (multiple-value-bind (value present outcomes)
            (libtmux:show-option client "renumber-windows" :scope :session :target session)
          (is (null value)) (is (eq t present)) (is (= 1 (length outcomes))))
        (libtmux:set-option client "@owned" value :scope :session :target session)
        (multiple-value-bind (records outcomes)
            (libtmux:show-options client :scope :session :target session :names '("@owned" "@owned" "@missing"))
          (is (= 3 (length records)))
          (is (string= value (getf (aref records 0) :value)))
          (setf (char (getf (aref records 0) :value) 0) #\X)
          (is (string= value (getf (aref records 1) :value)))
          (is (string= value (getf (libtmux:outcome-value (aref outcomes 0)) :value)))
          (is (not (getf (aref records 2) :present-p)))
          (is (find :failed outcomes :key #'libtmux:outcome-status)))
        (libtmux:set-option client "status-format" "" :scope :session :target session :key 7)
        (multiple-value-bind (value present) (libtmux:show-option client "status-format" :scope :session :target session :key 7)
          (is (equal "" value)) (is (eq t present)))
        (multiple-value-bind (value present) (libtmux:show-option client "status-format" :scope :session :target session :key 8)
          (is (null value)) (is (null present)))
        (when (libtmux.internal::version-at-least-p (libtmux:tmux-version client) "3.8")
          (let ((key (format nil "key~C~%雪" #\Tab)))
            (libtmux:set-option client "status-format" value :scope :session :target session :key key)
            (let* ((changed nil)
                   (libtmux.internal::*before-dispatch-hook*
                     (lambda (job)
                       (declare (ignore job))
                       (unless changed (setf changed t (char key 0) #\X)))))
              (is (equal value (libtmux:show-option client "status-format" :scope :session :target session :key key)))
              (is (eq t changed)))))
        (libtmux:set-option client "@ancestor" "global" :scope :global-window)
        (let* ((changed nil)
              (libtmux.internal::*before-dispatch-hook*
                (lambda (job)
                  (when (and (not changed)
                             (find-if (lambda (argument)
                                        (and (search "show-options" argument) (search "@ancestor" argument)
                                             (search "-g" argument) (search "-w" argument)))
                                      (libtmux.internal::process-job-argv job)))
                    (setf changed t)
                    (fixture-command fixture "set-option" "-w" "-t" (libtmux:id window) "@ancestor" "window")))))
          (let ((record (aref (libtmux:show-options client :scope :pane :target pane :names '("@ancestor")) 0)))
            (is (eq t changed))
            (is (string= "window" (getf record :value)))
            (is (eq :window (getf record :source-scope)))
            (is (eq t (getf record :inherited-p)))))
        (let ((options (libtmux:show-options client :scope :global-session))
              (hooks (libtmux:show-hooks client :scope :global-session)))
          (is (plusp (length options))) (is (plusp (length hooks)))
          (is (not (find "after-new-window" options :key (lambda (record) (getf record :name)) :test #'string=)))
          (is (find "after-new-window" hooks :key (lambda (record) (getf record :name)) :test #'string=)))
        (is (not control-launched))))))

(test decoded-environment-retains-hidden-removal-absence-and-native-failures
  (with-tmux-fixture (fixture)
    (libtmux:with-client (client :program (or (uiop:getenv "LIBTMUX_TEST_TMUX") "tmux") :socket-path (fixture-socket fixture))
      (libtmux:set-environment client "PRESENT" "" :scope :global)
      (libtmux:set-environment client "HIDDEN" (format nil "hidden~%雪") :scope :global :hidden t)
      (libtmux:remove-environment client "REMOVED" :scope :global)
      (multiple-value-bind (records outcomes)
          (libtmux:show-environment client :scope :global :names '("PRESENT" "HIDDEN" "REMOVED" "MISSING"))
        (is (equal '(:present :present :removed :absent) (map 'list (lambda (record) (getf record :state)) records)))
        (is (equal "" (getf (aref records 0) :value)))
        (is (not (getf (aref records 0) :hidden-p)))
        (is (getf (aref records 1) :hidden-p))
        (is (not (member :hidden-p (aref records 3))))
        (is (= 5 (length outcomes)))
        (is (eq :failed (libtmux:outcome-status (aref outcomes 4)))))
      (let* ((name (format nil "%end 0 0 0~%NAME")) (value (format nil "body~%%end 1 0 0~%tail")))
        (fixture-command fixture "set-environment" "-g" "--" name value)
        (is (string= value (getf (aref (libtmux:show-environment client :scope :global :names (vector name)) 0) :value)))))))

(test configuration-errors-retain-prior-records-and-failing-observations
  (with-tmux-fixture (fixture)
    (libtmux:with-client (client :program (or (uiop:getenv "LIBTMUX_TEST_TMUX") "tmux") :socket-path (fixture-socket fixture))
      (let* ((pane (aref (libtmux:fetch-panes client) 0))
             (session (aref (libtmux:fetch-sessions client) 0)))
        (libtmux:set-option client "@first" "first" :scope :pane :target pane)
        (libtmux:set-option client "@budget" "global" :scope :global-window)
        (let ((failure (handler-case
                           (libtmux:show-options client :scope :pane :target pane :names '("@first" "@budget") :record-limit 3)
                         (libtmux:configuration-read-failed (condition) condition))))
          (is (typep (libtmux:error-cause failure) 'libtmux:output-limit-exceeded))
          (is (equal "@budget" (libtmux:configuration-error-name failure)))
          (let ((partial (libtmux:configuration-partial-records failure)))
            (is (= 1 (length partial)))
            (setf (char (getf (aref partial 0) :value) 0) #\X)
            (is (equal "first" (getf (aref (libtmux:configuration-partial-records failure) 0) :value))))
          (is (= 4 (length (libtmux:configuration-read-outcomes failure)))))
        (libtmux:set-option client "@positive" "valid" :scope :session :target session)
        (let* ((installed nil)
               (libtmux.internal::*before-dispatch-hook*
                 (lambda (job)
                   (when (and (not installed)
                              (some (lambda (argument) (and (search "show-options" argument) (search "@positive" argument)))
                                    (libtmux.internal::process-job-argv job)))
                     (setf installed t)
                     (fixture-command fixture "set-hook" "-g" "after-show-options"
                                      "select-window -t =missing-configuration-window"))))
               (failure (handler-case
                            (libtmux:show-option client "@positive" :scope :session :target session)
                          (libtmux:configuration-read-failed (condition) condition))))
          (is (eq t installed))
          (is (typep failure 'libtmux:configuration-read-failed))
          (is (equal "valid" (getf (libtmux:outcome-value (libtmux:error-outcome failure)) :value))))))))

(test configuration-visibility-retries-share-the-original-owner
  (with-tmux-fixture (fixture)
    (libtmux:with-client (client :program (or (uiop:getenv "LIBTMUX_TEST_TMUX") "tmux") :socket-path (fixture-socket fixture))
      (libtmux:set-environment client "RACE" "hidden" :scope :global :hidden t)
      (let* ((changed nil)
             (libtmux.internal::*before-dispatch-hook*
               (lambda (job)
                 (when (and (not changed)
                            (some (lambda (argument)
                                    (and (search "show-environment" argument) (search "RACE" argument) (search "-h" argument)))
                                  (libtmux.internal::process-job-argv job)))
                   (setf changed t)
                   (fixture-command fixture "set-environment" "-gu" "RACE")
                   (fixture-command fixture "set-environment" "-g" "RACE" "visible")))))
        (multiple-value-bind (records outcomes) (libtmux:show-environment client :scope :global :names '("RACE"))
          (is (eq t changed))
          (is (equal "visible" (getf (aref records 0) :value)))
          (is (not (getf (aref records 0) :hidden-p)))
          (is (= 3 (length outcomes))))))))

(test incomplete-configuration-output-never-becomes-absence
  (with-tmux-fixture (fixture)
    (libtmux:with-client (client :program (or (uiop:getenv "LIBTMUX_TEST_TMUX") "tmux") :socket-path (fixture-socket fixture))
      (fixture-command fixture "set-option" "-g" "@large" (make-string 8192 :initial-element #\x))
      (let ((failure (handler-case
                         (libtmux:show-option client "@large" :scope :global-session :output-limit 4096)
                       (libtmux:configuration-read-failed (condition) condition))))
        (is (typep (libtmux:error-cause failure) 'libtmux:output-limit-exceeded))
        (is (zerop (length (libtmux:configuration-partial-records failure))))
        (is (not (nth-value 1 (libtmux:outcome-value (libtmux:error-outcome failure))))))
      (let* ((token (libtmux:make-cancellation-token))
             (libtmux.internal::*before-dispatch-hook*
               (lambda (job)
                 (when (some (lambda (argument) (and (search "show-options" argument) (search "@large" argument)))
                             (libtmux.internal::process-job-argv job))
                   (libtmux:cancel token))))
             (failure (handler-case
                          (libtmux:show-option client "@large" :scope :global-session :cancel-token token)
                        (libtmux:configuration-read-failed (condition) condition))))
        (is (typep (libtmux:error-cause failure) 'libtmux:command-cancelled))
        (is (zerop (length (libtmux:configuration-partial-records failure))))
        (is (not (nth-value 1 (libtmux:outcome-value (libtmux:error-outcome failure)))))))))
