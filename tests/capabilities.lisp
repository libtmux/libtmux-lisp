(in-package #:libtmux.tests)

(in-suite integration)

(test native-capabilities-observe-the-daemon-without-renewing-authority
  (with-tmux-fixture (fixture)
    (libtmux:with-client (client :program (or (uiop:getenv "LIBTMUX_TEST_CLIENT_TMUX")
                                             (uiop:getenv "LIBTMUX_TEST_TMUX") "tmux")
                                 :socket-path (fixture-socket fixture))
      (let* ((capture (libtmux:fetch-snapshot client))
             (generation (slot-value client 'libtmux::generation))
             (witness (slot-value client 'libtmux::witness))
             (version (libtmux:tmux-version client))
             (live-version (getf (libtmux:provenance capture) :server/version))
             (report nil))
        (dolist (hook '("after-display-message" "after-show-options"))
          (fixture-command fixture "set-hook" "-g" hook "set-option -g @cap-hook fired"))
        (fixture-command fixture "set-option" "-s" "command-alias[91]"
                         "run-shell=set-buffer -b cap-run-alias payload ; run")
        (fixture-command fixture "set-option" "-s" "command-alias[92]"
                         "if-shell=set-buffer -b cap-if-alias payload ; if")
        (unwind-protect
             (progn
               (is (string= "" (string-trim '(#\Newline)
                                 (fixture-command fixture "list-commands" "-F" "#{@cap-hook}" "list-sessions"))))
               (is (string= "" (fixture-command fixture "list-buffers" "-F" "#{buffer_name}")))
               (setf report (libtmux:capabilities client :timeout 0.9))
               (is (string= live-version (libtmux:capability-version report)))
               (is (= (fixture-pid fixture) (getf (libtmux:capability-provenance report) :server/pid)))
               (is (= generation (slot-value client 'libtmux::generation)))
               (is (eq witness (slot-value client 'libtmux::witness)))
               (is (string= version (libtmux:tmux-version client)))
               (is (string= "" (string-trim '(#\Newline)
                                 (fixture-command fixture "list-commands" "-F" "#{@cap-hook}" "list-sessions"))))
               (is (string= "" (fixture-command fixture "list-buffers" "-F" "#{buffer_name}")))
               (fixture-command fixture "show-options" "-gqv" "@cap-hook")
               (is (string= "fired" (string-trim '(#\Newline)
                                      (fixture-command fixture "list-commands" "-F" "#{@cap-hook}" "list-sessions")))))
          (fixture-command fixture "set-option" "-su" "command-alias[91]")
          (fixture-command fixture "set-option" "-su" "command-alias[92]")
          (fixture-command fixture "set-hook" "-gu" "after-display-message")
          (fixture-command fixture "set-hook" "-gu" "after-show-options"))
        (replace-fixture-server fixture)
        (let ((replacement (libtmux:capabilities client)))
          (is (= (fixture-pid fixture) (getf (libtmux:capability-provenance replacement) :server/pid)))
          (is (/= (getf (libtmux:capability-provenance report) :server/pid)
                  (getf (libtmux:capability-provenance replacement) :server/pid)))
          (is (= generation (slot-value client 'libtmux::generation)))
          (is (eq witness (slot-value client 'libtmux::witness))))
        (libtmux:close-client client)
        (is (string= live-version (libtmux:capability-version report)))))))

(test native-capabilities-do-not-start-cold-endpoints
  (let* ((directory (sb-posix:mkdtemp "/tmp/libtmux-lisp-caps-XXXXXX"))
         (socket (concatenate 'string directory "/socket")))
    (unwind-protect
         (libtmux:with-client (client :program (or (uiop:getenv "LIBTMUX_TEST_TMUX") "tmux")
                                      :socket-path socket)
           (signals libtmux:command-failed (libtmux:capabilities client :timeout 0.9))
           (is (not (probe-file socket)))
           (is (zerop (slot-value client 'libtmux::generation))))
      (uiop:delete-directory-tree (uiop:ensure-directory-pathname directory) :validate t))))

(in-suite control-integration)

(test control-capabilities-remain-on-the-original-connection
  (with-tmux-fixture (fixture)
    (libtmux:with-client (client :program (or (uiop:getenv "LIBTMUX_TEST_TMUX") "tmux")
                                 :socket-path (fixture-socket fixture))
      (let ((report (libtmux:capabilities client)))
        (if (not (libtmux:supports-p report :control))
            (skip "The native control resource requires tmux 3.8")
            (let* ((capture (libtmux:fetch-snapshot client))
                   (session (aref (libtmux:sessions capture) 0))
                   (generation (slot-value client 'libtmux::generation)))
              (libtmux.control:with-connection (connection client session)
                (dolist (hook '("after-display-message" "after-show-options"))
                  (fixture-command fixture "set-hook" "-g" hook "set-option -g @cap-control-hook fired"))
                (labels ((read-report ()
                           (multiple-value-bind (current delivery result)
                               (libtmux.control:await-capabilities
                                (libtmux.control:submit-capabilities connection :timeout 0.9) :timeout 0.9)
                             (is (eq :ready delivery))
                             (is (eq :completed (getf result :status)))
                             (is (equal (libtmux:capability-provenance report)
                                        (libtmux:capability-provenance current)))
                             current)))
                  (read-report)
                  (is (= generation (slot-value client 'libtmux::generation)))
                  (is (string= "" (string-trim '(#\Newline)
                                    (fixture-command fixture "list-commands" "-F" "#{@cap-control-hook}" "list-sessions"))))
                  (let ((backup (concatenate 'string (fixture-socket fixture) ".moved")))
                    (sb-posix:rename (fixture-socket fixture) backup)
                    (unwind-protect
                         (progn
                           (read-report)
                           (signals libtmux:command-failed (libtmux:capabilities client))
                           (is (= generation (slot-value client 'libtmux::generation)))
                           (is (not (probe-file (fixture-socket fixture)))))
                      (sb-posix:rename backup (fixture-socket fixture))))
                  (libtmux:close-client client)
                  (read-report)
                  (let* ((blocker (libtmux.control:submit-command connection '("wait-for" "cap-block")
                                                                :effect :read :timeout 0.9))
                         (request (libtmux.control:submit-capabilities connection :timeout 0.9)))
                    (unwind-protect
                         (progn
                           (multiple-value-bind (value delivery)
                               (libtmux.control:await-capabilities request :timeout 0)
                             (is (null value))
                             (is (eq :timeout delivery)))
                           (is (libtmux.control:cancel-request request))
                           (multiple-value-bind (value delivery result)
                               (libtmux.control:await-capabilities request :timeout 0)
                             (is (null value))
                             (is (eq :ready delivery))
                             (is (eq :cancelled (getf result :status))))
                           (is (eq :ready (libtmux.control:connection-state connection))))
                      (libtmux.control:cancel-request blocker)))
                  (libtmux.control:close-connection connection)
                  (signals libtmux.control:connection-closed
                    (libtmux.control:submit-capabilities connection))))))))))
