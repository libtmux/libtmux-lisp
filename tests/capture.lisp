(in-package #:libtmux.tests)

(in-suite integration)

(defun fixture-ok (fixture &rest arguments)
  (multiple-value-bind (output diagnostics code) (apply #'fixture-command fixture arguments)
    (unless (zerop code) (error "Fixture command failed: ~A" diagnostics))
    output))

(defmacro with-fixture-client ((client fixture) &body body)
  `(libtmux:with-client (,client :socket-path (fixture-socket ,fixture)
                                :program (or (uiop:getenv "LIBTMUX_TEST_TMUX") "tmux")
                                :config-file "/dev/null" :timeout 1)
     ,@body))

(test live-links-decoding-and-local-captures
  (with-tmux-fixture (fixture)
    (fixture-ok fixture "set-window-option" "-g" "automatic-rename" "off")
    (fixture-ok fixture "link-window" "-s" "@0" "-t" "fixture:3")
    (fixture-ok fixture "new-session" "-d" "-s" "second" "/bin/cat")
    (fixture-ok fixture "link-window" "-s" "@0" "-t" "second:5")
    (let ((title "λ%09,{}")
          (calls 0) (capture nil))
      (fixture-ok fixture "select-pane" "-t" "%0" "-T" title)
      (with-fixture-client (client fixture)
        (let ((libtmux.internal::*process-started-hook*
                (lambda (process) (declare (ignore process)) (incf calls))))
          (setf capture (libtmux:fetch-snapshot client))
          (is (= 5 calls))
          (is (= 2 (length (libtmux:sessions capture))))
          (is (= 2 (length (libtmux:windows capture))))
          (is (= 2 (length (libtmux:panes capture))))
          (is (= 4 (length (libtmux:window-links capture))))
          (let ((pane (find "%0" (libtmux:panes capture) :key #'libtmux:id :test #'equal)))
            (is (equal title (libtmux:title pane)))
            (libtmux:entity-data pane)
            (is (= 5 calls)))
          (let* ((window (aref (libtmux:windows capture) 0)) (old-name (libtmux:name window)))
            (fixture-ok fixture "rename-window" "-t" "@0" "changed")
            (let ((replacement (libtmux:refresh client window)))
              (is (libtmux:same-entity-p window replacement))
              (is (equal old-name (libtmux:name window)))
              (is (equal "changed" (libtmux:name replacement)))))
          (is (string= (libtmux:tmux-version client) (getf (libtmux:provenance capture) :server/version)))))
      (is (= 2 (length (libtmux:panes capture))))
      (is (zerop (nth-value 2 (fixture-command fixture "has-session")))))))

(test live-empty-and-absent-server-remain-distinct
  (with-tmux-fixture (fixture :socket-suffix (format nil "socket%09~C~C~C#{pid}\\," #\Tab #\Newline #\Return))
    (with-fixture-client (client fixture)
      (fixture-ok fixture "set-option" "-g" "exit-empty" "off")
      (fixture-ok fixture "kill-session" "-t" "fixture")
      (let* ((calls 0)
             (libtmux.internal::*process-started-hook*
               (lambda (process) (declare (ignore process)) (incf calls)))
             (capture (libtmux:fetch-snapshot client)))
        (is (= 4 calls))
        (is (zerop (length (libtmux:sessions capture))))
        (is (zerop (length (libtmux:panes capture))))
        (is (integerp (getf (libtmux:provenance capture) :server/pid)))
        (is (equal (fixture-socket fixture) (getf (libtmux:provenance capture) :server/socket-path)))))
    (libtmux:with-client (client :socket-path (concatenate 'string (fixture-socket fixture) "-absent")
                                :program (or (uiop:getenv "LIBTMUX_TEST_TMUX") "tmux") :timeout 1)
      (signals libtmux:command-failed (libtmux:fetch-snapshot client))
      (is (not (probe-file (concatenate 'string (fixture-socket fixture) "-absent")))))))

(test capture-contradictions-retry-with-one-budget
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let ((changed nil) (session-reads 0))
        (let* ((libtmux.internal::*before-dispatch-hook*
                 (lambda (job)
                   (let ((argv (libtmux.internal::process-job-argv job)))
                     (when (find-if (lambda (argument) (uiop:string-prefix-p "session/1" argument)) argv)
                       (incf session-reads))
                     (when (and (not changed) (find "list-windows" argv :test #'equal))
                       (setf changed t)
                       (fixture-ok fixture "new-window" "-d" "-t" "fixture" "/bin/cat")))))
               (capture (libtmux:fetch-snapshot client)))
          (is (not (null changed)))
          (is (= 2 session-reads))
          (is (= 2 (length (libtmux:windows capture)))))))))

(test batched-listing-hooks-retain-contradiction-retries
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (fixture-ok fixture "set-hook" "-g" "after-list-windows"
                  "set-hook -gu after-list-windows ; split-window -d -t fixture:0.0 /bin/cat")
      (let ((calls 0))
        (let* ((libtmux.internal::*process-started-hook*
                 (lambda (process) (declare (ignore process)) (incf calls)))
               (capture (libtmux:fetch-snapshot client)))
          (is (= 10 calls))
          (is (= 2 (length (libtmux:panes capture))))))
      (fixture-ok fixture "set-hook" "-g" "after-list-windows"
                  "split-window -d -t fixture:0.0 /bin/cat")
      (unwind-protect
           (let* ((calls 0)
                  (libtmux.internal::*process-started-hook*
                    (lambda (process) (declare (ignore process)) (incf calls))))
             (signals libtmux:incomplete-snapshot (libtmux:fetch-snapshot client))
             (is (= 15 calls)))
        (fixture-ok fixture "set-hook" "-gu" "after-list-windows")))))

(defclass capture-evidence-transport (libtmux.internal::subprocess-transport)
  ((mode :initarg :mode :initform :observe)
   (events :initform nil)))

(defmethod libtmux.internal::execute-command :around
    ((transport capture-evidence-transport) argv
     &key input timeout output-limit cancel-token keep-input-open)
  (declare (ignore input cancel-token keep-input-open))
  (let ((outcome (call-next-method)))
    (when (find "list-panes" argv :test #'equal)
      (ecase (slot-value transport 'mode)
        (:observe
         (setf (slot-value outcome 'libtmux::stderr)
               (libtmux.internal::octet-vector #(1 2 3))))
        (:malformed
         (setf (aref (slot-value outcome 'libtmux::stdout) 0) (char-code #\X)))
        (:foreign-witness
         (let* ((bytes (slot-value outcome 'libtmux::stdout))
                (text (libtmux.internal::strict-text bytes))
                (prefix (search (format nil "w/panes/1~C" #\Tab) text))
                (start (+ prefix (length "w/panes/1") 1))
                (end (position #\Tab text :start start)))
           (setf (slot-value outcome 'libtmux::stdout)
                 (libtmux.internal::encode-utf8
                  (concatenate 'string (subseq text 0 start) "1" (subseq text end))))))
        (:failed
         (setf (slot-value outcome 'libtmux::status) :failed
               (slot-value outcome 'libtmux::exit-code) 1
               (slot-value outcome 'libtmux::reason) :exit))))
    (push (list timeout output-limit outcome) (slot-value transport 'events))
    outcome))

(test batched-capture-shares-budgets-and-retains-failure-evidence
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let ((transport (make-instance 'capture-evidence-transport)))
        (setf (slot-value client 'libtmux::transport) transport)
        (libtmux:fetch-snapshot client :row-limit 1)
        (let ((events (reverse (slot-value transport 'events))))
          (is (= 5 (length events)))
          (loop for (previous current) on events while current
                for outcome = (third previous)
                do (is (= (second current)
                          (- (second previous)
                             (length (libtmux:outcome-stdout outcome))
                             (length (libtmux:outcome-stderr outcome)))))
                   (is (<= (first current) (first previous))))
          (is (equalp #(1 2 3) (libtmux:outcome-stderr (third (fourth events))))))
        (dolist (mode '(:malformed :failed :foreign-witness))
          (setf (slot-value transport 'mode) mode
                (slot-value transport 'events) nil)
          (handler-case
              (progn (libtmux:fetch-snapshot client) (fail "Invalid batch was accepted"))
            (libtmux:libtmux-error (condition)
              (is (typep condition (ecase mode
                                     (:malformed 'libtmux:decoding-error)
                                     (:failed 'libtmux:command-failed)
                                     (:foreign-witness 'libtmux:incomplete-snapshot))))
              (is (eq (libtmux:error-outcome condition)
                      (third (first (slot-value transport 'events)))))
              (is (= (if (eq mode :foreign-witness) 12 4)
                     (length (slot-value transport 'events)))))))
        (is (null (slot-value client 'libtmux::witness)))
        (setf (slot-value transport 'mode) :observe)
        (is (= 1 (length (libtmux:fetch-panes client))))))))

(test batched-capture-preserves-cancel-and-deadline-admission
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (dolist (phase '(:before :after))
        (dolist (reason '(:cancel :deadline))
          (let ((token (libtmux:make-cancellation-token)) (batch nil))
            (flet ((interrupt ()
                     (if (eq reason :cancel) (libtmux:cancel token)
                         (setf (libtmux.internal::process-job-deadline batch) 0))))
              (let ((libtmux.internal::*before-dispatch-hook*
                      (lambda (job)
                        (when (find "list-panes" (libtmux.internal::process-job-argv job)
                                    :test #'equal)
                          (setf batch job)
                          (when (eq phase :before) (interrupt)))))
                    (libtmux.internal::*process-started-hook*
                      (lambda (process)
                        (declare (ignore process))
                        (when (and batch (eq phase :after)) (interrupt)))))
                (handler-case
                    (progn (libtmux:fetch-snapshot client :cancel-token token)
                           (fail "Interrupted batch completed"))
                  (libtmux:libtmux-error (condition)
                    (is (typep condition (if (eq reason :cancel)
                                            'libtmux:command-cancelled
                                            'libtmux:deadline-exceeded)))
                    (is (not (null batch)))
                    (when (eq phase :before)
                      (is (eq :not-dispatched
                              (libtmux:outcome-status (libtmux:error-outcome condition))))))))))))
      (is (= 1 (length (libtmux:fetch-panes client)))))))

(defun replace-fixture-server (fixture)
  (fixture-ok fixture "kill-server")
  (unless (sb-sys:wait-until-fd-usable (fixture-pidfd fixture) :input 0.5)
    (error "Old fixture server did not terminate"))
  (sb-posix:close (fixture-pidfd fixture))
  (setf (fixture-pidfd fixture) nil)
  (fixture-ok fixture "new-session" "-d" "-s" "fixture" "/bin/cat")
  (setf (fixture-pid fixture)
        (parse-integer (fixture-ok fixture "display-message" "-p" "#{pid}") :junk-allowed t)
        (fixture-pidfd fixture) (fixture-pidfd-open (fixture-pid fixture) 0))
  (when (minusp (fixture-pidfd fixture)) (error "Cannot retain replacement fixture pidfd")))

(test replacement-and-renumbering-invalidate-targets
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let* ((capture (libtmux:fetch-snapshot client))
             (pane (aref (libtmux:panes capture) 0))
             (link (aref (libtmux:window-links capture) 0)))
        (fixture-ok fixture "move-window" "-s" "fixture:0" "-t" "fixture:4")
        (signals libtmux:stale-target (libtmux:refresh client link))
        (is (libtmux:same-entity-p pane (libtmux:refresh client pane)))
        (replace-fixture-server fixture)
        (let ((replacement (aref (libtmux:fetch-panes client) 0)))
          (is (equal (libtmux:id pane) (libtmux:id replacement)))
          (is (not (libtmux:same-entity-p pane replacement))))
        (signals libtmux:stale-target (libtmux:refresh client pane))
        (is (stringp (libtmux:current-command pane)))))))

(test attached-client-presence-and-observation-identity
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let ((observation nil))
        (call-with-attached-terminal-client
         fixture
         (lambda (terminal)
           (let ((clients (libtmux:fetch-clients client)))
             (is (= 1 (length clients)))
             (setf observation (aref clients 0))
             (is (= (sb-ext:process-pid (terminal-client-process terminal))
                    (libtmux:field-value observation :client/pid)))
             (is (equal '(nil t) (multiple-value-list (libtmux:field-value observation :client/control-mode))))
             (multiple-value-bind (tty present-p) (libtmux:field-value observation :client/tty)
               (is (eq t present-p))
               (is (uiop:string-prefix-p "/dev/pts/" tty)))
             (is (equal "fixture" (libtmux:name (libtmux:session observation))))
             (is (not (libtmux:same-entity-p observation (libtmux:refresh client observation)))))))
        (is (zerop (length (libtmux:fetch-clients client))))
        (signals libtmux:stale-target (libtmux:refresh client observation))))))

(test acquisition-resource-bounds
  (with-tmux-fixture (fixture)
    (with-fixture-client (client fixture)
      (let ((calls 0) (token (libtmux:make-cancellation-token)))
        (libtmux:cancel token)
        (let ((libtmux.internal::*process-started-hook*
                (lambda (process) (declare (ignore process)) (incf calls))))
          (signals libtmux:command-cancelled (libtmux:fetch-snapshot client :cancel-token token))
          (signals libtmux:deadline-exceeded (libtmux:fetch-snapshot client :timeout 0))
          (is (zerop calls)))
        (signals libtmux:output-limit-exceeded (libtmux:fetch-snapshot client :output-limit 16))
        (signals libtmux:output-limit-exceeded (libtmux:fetch-snapshot client :entity-limit 1))
        (is (= 1 (length (libtmux:fetch-panes client))))))))

(test selected-socket-alias-cannot-mix-daemons
  (with-tmux-fixture (first)
    (with-tmux-fixture (second)
      (fixture-ok second "rename-session" "-t" "fixture" "foreign")
      (let ((alias (concatenate 'string (namestring (fixture-directory first)) "alias"))
            (redirected nil) (restored nil))
        (sb-posix:symlink (fixture-socket first) alias)
        (libtmux:with-client (client :socket-path alias
                                    :program (or (uiop:getenv "LIBTMUX_TEST_TMUX") "tmux") :timeout 1)
          (let* ((libtmux.internal::*before-dispatch-hook*
                   (lambda (job)
                     (let* ((argv (libtmux.internal::process-job-argv job))
                            (listing (find-if
                                      (lambda (argument)
                                        (some (lambda (prefix) (uiop:string-prefix-p prefix argument))
                                              '("session/1" "window-link/1" "pane/1" "client/1"))) argv)))
                       (cond ((and listing (not redirected))
                              (sb-posix:unlink alias)
                              (sb-posix:symlink (fixture-socket second) alias)
                              (setf redirected t))
                             ((and redirected (not listing) (not restored))
                              (sb-posix:unlink alias)
                              (sb-posix:symlink (fixture-socket first) alias)
                              (setf restored t))))))
                 (capture (libtmux:fetch-snapshot client)))
            (is (and redirected restored))
            (is (equal "fixture" (libtmux:name (aref (libtmux:sessions capture) 0))))
            (is (= (fixture-pid first) (getf (libtmux:provenance capture) :server/pid)))))))))

(test listing-peer-replacement-invalidates-attempt
  (with-tmux-fixture (first)
    (with-tmux-fixture (second)
      (fixture-ok second "rename-session" "-t" "fixture" "foreign")
      (let* ((selected (fixture-socket first))
             (backup (concatenate 'string selected "-saved"))
             (switched nil) (restored nil) (retained-fd nil))
        (labels ((restore-socket ()
                   (when (and switched (not restored))
                     (sb-posix:unlink selected)
                     (sb-posix:rename backup selected)
                     (setf restored t))))
          (unwind-protect
               (with-fixture-client (client first)
                 (let* ((libtmux.internal::*before-dispatch-hook*
                          (lambda (job)
                            (let* ((argv (libtmux.internal::process-job-argv job))
                                   (listing (find ";" argv :test #'equal)))
                              (cond ((and switched (not restored) (not listing))
                                     (restore-socket))
                                    ((and (not switched) listing)
                                     (sb-posix:rename selected backup)
                                     (sb-posix:symlink (fixture-socket second) selected)
                                     (setf switched t))))))
                        (capture (libtmux:fetch-snapshot client)))
                   (is (and switched restored))
                   (is (equal "fixture" (libtmux:name (aref (libtmux:sessions capture) 0))))
                   (is (= (fixture-pid first) (getf (libtmux:provenance capture) :server/pid)))
                   (is (> (getf (libtmux:provenance capture) :generation) 1))
                   (setf retained-fd
                         (libtmux.internal::server-witness-fd (slot-value client 'libtmux::witness)))))
            (restore-socket)))
        (let ((closed (handler-case (progn (sb-posix:fcntl retained-fd sb-posix:f-getfd) nil)
                        (sb-posix:syscall-error (condition)
                          (= (sb-posix:syscall-errno condition) sb-posix:ebadf)))))
          (is (eq t closed)))))))
